  d=>{const n=rand(2,d.mulN),a=rand(2,d.mulA);return wp(`Ein Creeper lässt ${a} Schießpulver fallen. Du besiegst ${n} Creeper. Wie viel Schießpulver hast du?`,n*a)},
  d=>{const a=rand(5,d.sub),b=rand(1,a-1);return wp(`Auf dem Feld wachsen ${a} Weizen. Du erntest ${b}. Wie viele Weizen stehen noch?`,a-b)},
  d=>{const a=rand(3,d.add),b=rand(2,d.add);return wp(`Du angelst ${a} Fische und fängst dann noch ${b}. Wie viele Fische hast du?`,a+b)},
