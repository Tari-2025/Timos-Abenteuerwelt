  #levelOverlay .dialog .primary{
    display:block;
    width:min(100%,280px);
    margin:8px auto 0 !important;
  }
  .collection{
    gap:8px;
  }
  .collection .item{
    padding:10px 8px;
  }
}

/* Very narrow devices */
@media (max-width: 390px){
  .brand-title{
    font-size:clamp(21px,8vw,30px);
  }
  .brand-icon{
    width:36px;
    height:36px;
  }
  .topbar{
    padding:8px;
  }
  .scene{
    min-height:200px;
  }
  .question{
    font-size:clamp(26px,9vw,38px);
  }
  .answer{
    max-width:210px;
    font-size:30px;
  }
  .mechanic-row{
    grid-template-columns:1fr;
  }
  .mechanic-card{
    min-height:auto;
  }
  .inventory{
    justify-content:center;
    overflow-x:visible;
  }
  .slot{
    width:42px;
    height:42px;
    min-width:42px;
  }
  .collection{
    grid-template-columns:1fr;
  }
}

/* Short windows (height-based) */
@media (max-height: 760px){
  .scene{
    min-height:clamp(190px,34vh,260px);
  }
  .build-area{
    min-height:clamp(220px,36vh,290px);
  }
  .dialog{
    max-height:90vh;
    overflow:auto;
  }
}


/* ===================================================================== */
/* ==========  v6.4 – LÜCKEN- & TEXTAUFGABEN + BOSS-LEVEL  ============= */
/* ===================================================================== */

/* ---- Aufgaben-Darstellung: Textaufgabe & Lücke ---- */
.question.word{
  font-size:clamp(17px,2.6vw,26px);line-height:1.35;font-weight:800;
  white-space:normal;max-width:min(560px,94%);margin-left:auto;margin-right:auto;
}
.blank{
  display:inline-block;min-width:.95em;padding:0 .18em;
  color:#ffd23f;background:rgba(255,210,63,.16);
  border-bottom:4px solid #ffd23f;border-radius:4px;font-weight:1000;
}

/* ---- Boss: Body- & Szenen-Hintergrund ---- */
body.theme-boss{background:radial-gradient(circle at 50% -10%,#3d2456,#1a1226 72%)}
.scene.boss{background:linear-gradient(#241436,#3c2350 55%,#3a2412 55%)}

/* ---- Boss-Arena (deckt die Fahrt-Szene ab) ---- */
.boss-arena{
  position:absolute;inset:0;z-index:9;display:none;overflow:hidden;
  background:linear-gradient(#241436,#3c2350 55%,#4a2f1a 55%,#3a2412);
}
.boss-arena.show{display:block}
.boss-arena.end{background:linear-gradient(#07070f,#140f24 60%,#2b2842 60%,#20203a)}
.boss-ground{
  position:absolute;left:0;right:0;bottom:0;height:46px;
  background:repeating-linear-gradient(90deg,#5a3b22 0 24px,#4d3119 24px 48px);
  border-top:4px solid #6b4526;
}
.boss-arena.end .boss-ground{
  background:repeating-linear-gradient(90deg,#d9d7a6 0 24px,#c9c795 24px 48px);
  border-top-color:#b3b184;
}
.boss-healthbar{
  position:absolute;top:10px;left:50%;transform:translateX(-50%);
  width:min(72%,360px);height:20px;background:#3a2a2a;border:3px solid #12100f;
  border-radius:6px;overflow:hidden;z-index:3;
}
.boss-health-fill{height:100%;width:100%;background:linear-gradient(#ff6b60,#c62f28);transition:width .55s cubic-bezier(.3,1,.5,1)}
.boss-health-label{position:absolute;top:11px;left:50%;transform:translateX(-50%);font-size:12px;font-weight:1000;color:#fff;text-shadow:0 1px 2px #000;z-index:4}
.boss-name{position:absolute;top:36px;left:50%;transform:translateX(-50%);font-weight:1000;font-size:clamp(15px,2.4vw,22px);color:#ffe3a1;text-shadow:0 2px 0 #000;z-index:3;white-space:nowrap}
.boss-hitfx{position:absolute;right:22%;bottom:130px;z-index:6;font-weight:1000;font-size:26px;color:#fff;text-shadow:0 3px 0 #b3261e;opacity:0;pointer-events:none}
.boss-hitfx.show{animation:hitPow .6s ease}
@keyframes hitPow{0%{opacity:0;transform:scale(.4)}25%{opacity:1;transform:scale(1.25)}100%{opacity:0;transform:scale(1) translateY(-26px)}}

/* ---- Held im Boss-Kampf ---- */
.boss-hero{position:absolute;left:9%;bottom:44px;width:56px;height:120px;z-index:2;image-rendering:pixelated}
.boss-hero.attack{animation:heroAttack .5s ease}
@keyframes heroAttack{0%,100%{transform:translateX(0)}45%{transform:translateX(46px)}}
.boss-hero.flinch{animation:heroFlinch .45s ease}
@keyframes heroFlinch{0%,100%{transform:translateX(0) rotate(0)}30%{transform:translateX(-16px) rotate(-7deg)}}
.boss-hero .h-hair{position:absolute;top:0;left:14px;width:28px;height:8px;background:#3a2a17}
.boss-hero .h-head{position:absolute;top:6px;left:14px;width:28px;height:24px;background:#c98d5a;box-shadow:inset 0 0 0 3px #a9713f}
.boss-hero .h-eye{position:absolute;top:14px;width:5px;height:6px;background:#2a2f6a}
.boss-hero .h-eye.e1{left:19px}.boss-hero .h-eye.e2{left:30px}
.boss-hero .h-body{position:absolute;top:30px;left:16px;width:24px;height:38px;background:#12a3b0;box-shadow:inset 0 0 0 3px #0d7f8a}
.boss-hero .h-arm{position:absolute;top:32px;width:9px;height:30px;background:#c98d5a;box-shadow:inset 0 0 0 2px #a9713f}
.boss-hero .h-arm.a1{left:8px}.boss-hero .h-arm.a2{right:8px}
.boss-hero .h-leg{position:absolute;bottom:0;width:10px;height:34px;background:#3a4a86}
.boss-hero .h-leg.l1{left:17px}.boss-hero .h-leg.l2{right:17px}
.boss-hero .h-sword{position:absolute;top:18px;right:-8px;width:6px;height:42px;background:linear-gradient(#eef,#bcd);border:2px solid #889;transform-origin:bottom center;transform:rotate(18deg)}
.boss-hero .h-sword::after{content:"";position:absolute;left:-4px;bottom:6px;width:14px;height:5px;background:#7a5a2b}
.boss-hero.attack .h-sword{animation:swordSwing .5s ease}
@keyframes swordSwing{0%{transform:rotate(18deg)}45%{transform:rotate(-72deg)}100%{transform:rotate(18deg)}}

/* ---- Gegner allgemein ---- */
.boss-enemy{position:absolute;right:9%;bottom:44px;z-index:2;image-rendering:pixelated;transform-origin:bottom center;animation:enemyIdle 2.4s ease-in-out infinite}
@keyframes enemyIdle{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}

/* Creeper */
.boss-enemy.creeper{width:70px;height:150px}
.creeper .cr-head{position:absolute;top:0;left:11px;width:48px;height:48px;background:#6cc349;box-shadow:inset 0 0 0 3px #56a637}
.creeper .cr-body{position:absolute;top:48px;left:17px;width:36px;height:78px;background:#6cc349;box-shadow:inset 0 0 0 3px #56a637}
.creeper .cr-foot{position:absolute;bottom:0;width:18px;height:16px;background:#56a637}
.creeper .f1{left:14px}.creeper .f2{right:14px}
.creeper .cr-eye{position:absolute;top:14px;width:11px;height:11px;background:#14210f}
.creeper .cr-eye.e1{left:9px}.creeper .cr-eye.e2{right:9px}
.creeper .cr-mouth{position:absolute;top:25px;left:19px;width:10px;height:20px;background:#14210f}
.creeper .cr-mouth::before{content:"";position:absolute;left:-7px;top:8px;width:7px;height:12px;background:#14210f}
.creeper .cr-mouth::after{content:"";position:absolute;right:-7px;top:8px;width:7px;height:12px;background:#14210f}

/* Zombie */
.boss-enemy.zombie{width:74px;height:150px}
.zombie .z-head{position:absolute;top:0;left:17px;width:40px;height:40px;background:#4a7a3a;box-shadow:inset 0 0 0 3px #3c6630}
.zombie .z-eye{position:absolute;top:20px;width:9px;height:8px;background:#0e2a12;box-shadow:0 0 4px #1c6b2a}
.zombie .z-eye.e1{left:7px}.zombie .z-eye.e2{right:7px}
.zombie .z-body{position:absolute;top:40px;left:22px;width:30px;height:52px;background:#2f9e8f;box-shadow:inset 0 0 0 3px #24796e}
.zombie .z-arm{position:absolute;top:44px;width:38px;height:12px;background:#4a7a3a;box-shadow:inset 0 0 0 3px #3c6630}
.zombie .z-arm.a1{left:-18px}.zombie .z-arm.a2{right:-18px}
.zombie .z-leg{position:absolute;bottom:0;width:13px;height:40px;background:#2f4a86;box-shadow:inset 0 0 0 3px #24386a}
.zombie .z-leg.l1{left:24px}.zombie .z-leg.l2{right:24px}

/* Skelett */
.boss-enemy.skeleton{width:74px;height:148px}
.skeleton .s-head{position:absolute;top:0;left:18px;width:38px;height:34px;background:#d9dde0;box-shadow:inset 0 0 0 3px #b9c0c4}
.skeleton .s-eye{position:absolute;top:12px;width:9px;height:9px;background:#14140f}
.skeleton .s-eye.e1{left:7px}.skeleton .s-eye.e2{right:7px}
.skeleton .s-spine{position:absolute;top:34px;left:35px;width:5px;height:58px;background:#d9dde0}
.skeleton .s-rib{position:absolute;left:22px;width:30px;height:5px;background:#cfd4d7}
.skeleton .s-rib.r1{top:44px}.skeleton .s-rib.r2{top:56px}.skeleton .s-rib.r3{top:68px}
.skeleton .s-leg{position:absolute;bottom:0;width:6px;height:44px;background:#d9dde0}
.skeleton .s-leg.l1{left:30px}.skeleton .s-leg.l2{right:30px}
.skeleton .s-bow{position:absolute;top:34px;right:4px;width:16px;height:62px;border:4px solid #8a5a2b;border-left:none;border-radius:0 44px 44px 0;background:transparent}
.skeleton .s-bow::after{content:"";position:absolute;left:1px;top:-6px;bottom:-6px;width:2px;background:#eaeaea}

/* Spinne */
.boss-enemy.spider{width:130px;height:78px;bottom:44px;transform-origin:center}
.spider .sp-body{position:absolute;right:6px;bottom:8px;width:54px;height:44px;background:#3a2a22;border-radius:44%;box-shadow:inset 0 0 0 4px #29201a}
.spider .sp-head{position:absolute;right:54px;bottom:16px;width:30px;height:28px;background:#4a352a;border-radius:44%}
.spider .sp-eye{position:absolute;width:6px;height:6px;background:#ff3b30;border-radius:50%;box-shadow:0 0 5px #ff3b30}
.spider .sp-eye.e1{right:74px;bottom:34px}.spider .sp-eye.e2{right:64px;bottom:34px}
.spider .sp-leg{position:absolute;bottom:16px;width:32px;height:5px;background:#221812;border-radius:3px}
.spider .spl1{right:52px;transform-origin:right center;transform:rotate(30deg)}
.spider .spl2{right:56px;transform-origin:right center;transform:rotate(8deg)}
.spider .spl3{right:58px;bottom:10px;transform-origin:right center;transform:rotate(-16deg)}
.spider .spr1{right:8px;transform-origin:left center;transform:rotate(-30deg)}
.spider .spr2{right:4px;transform-origin:left center;transform:rotate(-8deg)}
.spider .spr3{right:2px;bottom:10px;transform-origin:left center;transform:rotate(16deg)}

/* Enderdrache (Finale) */
.boss-enemy.dragon{width:180px;height:130px;right:6%;bottom:auto;top:20%;animation:dragonFloat 3s ease-in-out infinite}
@keyframes dragonFloat{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
.dragon .d-body{position:absolute;left:58px;top:44px;width:74px;height:30px;background:#1a1626;border-radius:14px;box-shadow:inset 0 0 0 3px #2c2540}
.dragon .d-neck{position:absolute;left:112px;top:26px;width:20px;height:34px;background:#1a1626;transform:rotate(22deg)}
.dragon .d-head{position:absolute;left:122px;top:8px;width:46px;height:26px;background:#211a30;border-radius:6px;box-shadow:inset 0 0 0 3px #2c2540}
.dragon .d-eye{position:absolute;left:152px;top:14px;width:8px;height:8px;background:#c77dff;border-radius:50%;box-shadow:0 0 7px #c77dff}
.dragon .d-tail{position:absolute;left:2px;top:50px;width:62px;height:12px;background:#1a1626;border-radius:8px;transform-origin:right center;animation:dTail 2s ease-in-out infinite}
@keyframes dTail{0%,100%{transform:rotate(-7deg)}50%{transform:rotate(9deg)}}
.dragon .d-wing{position:absolute;width:74px;height:52px;background:#2a2140;clip-path:polygon(0 100%,18% 0,100% 28%,58% 100%);transform-origin:bottom left}
.dragon .d-wing.w1{left:60px;top:-8px;animation:dWing 1.1s ease-in-out infinite}
.dragon .d-wing.w2{left:66px;top:10px;opacity:.65;animation:dWing 1.1s ease-in-out .12s infinite}
@keyframes dWing{0%,100%{transform:rotate(-6deg) scaleY(1)}50%{transform:rotate(-30deg) scaleY(.7)}}

/* ---- Gegner-Zustände (nach den Gegnern, damit sie gewinnen) ---- */
.boss-enemy.hit{animation:enemyHit .45s ease}
@keyframes enemyHit{0%{transform:translate(0,0)}20%{transform:translate(26px,-4px) rotate(4deg);filter:brightness(3) saturate(.2)}60%{transform:translate(12px,0)}100%{transform:translate(0,0)}}
.boss-enemy.attack{animation:enemyAttack .5s ease}
@keyframes enemyAttack{0%,100%{transform:translateX(0)}40%{transform:translateX(-42px) rotate(-3deg)}}
.boss-enemy.defeated{animation:enemyDefeat 1s ease forwards;pointer-events:none}
@keyframes enemyDefeat{0%{transform:translateY(0) rotate(0);opacity:1}35%{transform:translateY(-12px) rotate(10deg)}100%{transform:translateY(70px) rotate(90deg);opacity:0}}

@media (prefers-reduced-motion: reduce){
  .boss-enemy,.dragon .d-tail,.dragon .d-wing{animation:none !important}
}

</style>
</head>

