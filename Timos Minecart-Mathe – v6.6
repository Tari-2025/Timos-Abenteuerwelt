/* ---- v6.0: abwechselndes Lob, Reaktionen, Konfetti, Meilensteine ---- */
const PRAISE=["Super","Stark","Klasse","Mega","Perfekt","Genau richtig","Volltreffer","Spitze","Wow","Bärenstark","Klasse gemacht"];
function praise(){return PRAISE[Math.floor(Math.random()*PRAISE.length)]}

function riderReact(type){
  const r=document.querySelector("#cartWrap .rider");
  const pet=document.querySelector("#cartWrap .pet");
  if(r){
    r.classList.remove("cheer","oops");void r.offsetWidth;
    r.classList.add(type==="cheer"?"cheer":"oops");
    r.addEventListener("animationend",()=>r.classList.remove("cheer","oops"),{once:true});
  }
  if(pet && type==="cheer"){
    pet.classList.remove("happy");void pet.offsetWidth;pet.classList.add("happy");
    pet.addEventListener("animationend",()=>pet.classList.remove("happy"),{once:true});
  }
}

function launchConfetti(count=46){
  let layer=$("confettiLayer");
  if(!layer){
    layer=document.createElement("div");
    layer.id="confettiLayer";
    layer.style.cssText="position:fixed;inset:0;pointer-events:none;z-index:60;overflow:hidden";
    document.body.appendChild(layer);
  }
  const colors=["#f6c84d","#6fd244","#e76b61","#65e7ff","#ff9f28","#c77dff","#ffffff","#78d64b"];
  const H=window.innerHeight;
  for(let i=0;i<count;i++){
    const p=document.createElement("div");
    const size=6+Math.random()*8;
    p.style.cssText=`position:absolute;top:-18px;left:${Math.random()*100}%;width:${size}px;height:${size}px;background:${colors[i%colors.length]};border-radius:${Math.random()<.5?"1px":"50%"}`;
    layer.appendChild(p);
    const xDrift=(Math.random()*2-1)*170;
    const rot=(Math.random()*2-1)*760;
    const dur=1500+Math.random()*1500;
    const anim=p.animate([
      {transform:"translate(0,0) rotate(0deg)",opacity:1},
      {transform:`translate(${xDrift}px,${H*0.9}px) rotate(${rot}deg)`,opacity:1,offset:.85},
      {transform:`translate(${xDrift}px,${H+70}px) rotate(${rot}deg)`,opacity:0}
    ],{duration:dur,delay:Math.random()*260,easing:"cubic-bezier(.2,.6,.4,1)",fill:"forwards"});
    anim.finished.then(()=>p.remove()).catch(()=>{});
  }
}

function celebrateMilestone(n){
  const banner=$("milestoneBanner");
  if(banner){
    banner.textContent=`★ ${n} Sterne! ★`;
    banner.classList.remove("show");void banner.offsetWidth;banner.classList.add("show");
  }
  launchConfetti(64);
  Sound.level();
}

function rewardOne(){
  state.items.rail++;
  let bonus=null;
  const roll=Math.random();
  if(roll<.55){
    const extras=[
      {id:"wood",icon:"i-wood",label:"Holz"},
      {id:"stone",icon:"i-stone",label:"Stein"}
    ];
    bonus=extras[Math.floor(Math.random()*extras.length)]
  }else if(roll<.72){
    bonus={id:"emerald",icon:"i-emerald",label:"Smaragd"}
  }else if(roll<.78){
    bonus={id:"pickaxe",icon:"i-pickaxe",label:"Spitzhacke"}
  }else if(roll<.86){
    bonus={id:"gold",icon:"i-gold",label:"Gold"}
  }
  if(bonus)state.items[bonus.id]++;
  return bonus
}

function rewardDecoration(){
  const pool=unlockedDecos();
  if(!pool.length || Math.random()>=.22)return null;
  const deco=weightedRandom(pool);
  if(!deco)return null;
  state.decorations[deco.id]++;
  return deco
}

function checkAnswer(){
  Sound.init();
  const v=$("answer").value.trim();
  if(v===""){feedback("Gib erst eine Zahl ein.");return}
  if(Number(v)!==state.currentTask.answer){
    Sound.wrong();
    if(isBoss()){ bossEnemyAttack(); feedback(`${bossEnemyLabel()} weicht aus! Rechne noch einmal.`,"#ffd0a2"); }
    else { riderReact("oops"); feedback("Fast! Probier es noch einmal.","#ffaaa2"); }
    $("answer").select();return
  }
  const previousStars=state.totalStars;
  state.levelScore++;state.totalStars++;
  const bonus=rewardOne();
  const decoReward=rewardDecoration();
  Sound.correct();Sound.reward();
  riderReact("cheer");
  const boss=isBoss();
  if(boss){ bossHit(); } else { burstIcon(bonus?bonus.icon:"i-rail"); }
  updateUI();save();
  const done=state.levelScore>=CONFIG.tasksPerLevel;
  const hitMilestone=state.totalStars>0 && state.totalStars%10===0;
  if(hitMilestone) celebrateMilestone(state.totalStars);
  const newlyUnlocked=BUILD_THEMES.find(t=>t.unlock>previousStars && t.unlock<=state.totalStars);
  if(boss){
    if(done){ bossDefeat(); feedback(`Besiegt! ${praise()}, ${CONFIG.playerName}!`,"#9cff86"); }
    else feedback(`Treffer! ${bossEnemyLabel()} verliert Kraft.`,"#9cff86");
  }else if(newlyUnlocked){
    feedback(`${praise()}, ${CONFIG.playerName}! Neuer Bau-Hintergrund freigeschaltet: ${newlyUnlocked.name}.`,"#9cff86");
  }else if(decoReward){
    const extra=bonus?` Außerdem bekommst du ${bonus.label}.`:"";
    feedback(`${praise()}! Du hast Hintergrunddeko verdient: ${decoReward.label}.${extra}`,"#9cff86");
  }else{
    feedback(bonus
      ? `${praise()}, ${CONFIG.playerName}! Du bekommst 1 Schiene und zusätzlich ${bonus.label}.`
      : `${praise()}, ${CONFIG.playerName}! Du bekommst 1 Schiene für deine Achterbahn.`,
      "#9cff86"
    );
  }
  if(done) setTimeout(showLevelComplete, boss?1150:650);
  else setTimeout(makeTask,800)
}

function showLevelComplete(){
  $("answer").value="";
  const bonus=REWARDS.rare[Math.floor(Math.random()*REWARDS.rare.length)];
  state.items[bonus.id]++;

  const last=state.levelIndex===CONFIG.levels.length-1;
  const boss=isBoss();
  if(boss) state.items.gold++;
  $("surpriseIcon").innerHTML=`<div class="chest"><div class="glow"></div><div class="loot">${svgIcon(last?"i-trophy":bonus.icon,"icon-xl")}</div><div class="box"></div><div class="lid"></div></div>`;
  $("surpriseTitle").textContent=last?"Alle Welten geschafft!":(boss?"Boss besiegt!":"Level geschafft!");
  $("surpriseText").textContent=last
    ? `Du hast alle Welten und Bosse gemeistert. ${CONFIG.playerName} bekommt zum Abschluss:`
    : (boss
        ? `${CONFIG.playerName} hat ${currentLevel().title} bezwungen und erbeutet extra Gold sowie:`
        : `Die Lore erreicht das Ziel. ${CONFIG.playerName} bekommt als Bonus:`);
  $("bonus").innerHTML=`${svgIcon(bonus.icon,"icon-md")} <span>${bonus.label}</span>`;
  $("continueBtn").textContent=last?"Nochmal von vorn":"Weiter zum nächsten Level";
  $("levelOverlay").classList.add("open");
  const chest=$("surpriseIcon").querySelector(".chest");
  setTimeout(()=>{ if(chest)chest.classList.add("open"); Sound.reward(); launchConfetti(54); },430);
  Sound.level();updateUI();save()
}

function nextLevel(){
  $("levelOverlay").classList.remove("open");
  if(state.levelIndex<CONFIG.levels.length-1)state.levelIndex++;
  else state.levelIndex=0;
  state.levelScore=0;
  updateUI();makeTask();
  Sound.newLevel();
  feedback(state.levelIndex===0?"Neue Runde beginnt!":"Neue Welt – los geht's!");
  save()
}

/* ---------- BUILDER ---------- */
let selectedPiece="straight",deleteMode=false,clearArmed=false,clearTimer=null;
const STEP_HEIGHT=26;

function buildStatus(msg,danger=false){
  $("buildStatus").textContent=msg;
  $("buildStatus").style.color=danger?"#ffaaa2":"#d5ddd5"
}
function elevationBefore(index){
  let h=0;
  for(let i=0;i<index;i++){
    const p=state.build[i];
    if(p==="up")h++;
    if(p==="down")h--
  }
  return h
}
let selectedDeco=null,decoRemoveMode=false;
function unlockedDecos(){
  return DECOS.filter(deco=>state.totalStars>=(deco.unlock||0));
}
function weightedRandom(items){
  const total=items.reduce((sum,item)=>sum+Math.max(1,item.weight||1),0);
  let roll=Math.random()*total;
  for(const item of items){
    roll-=Math.max(1,item.weight||1);
    if(roll<=0) return item;
  }
  return items[items.length-1]||null;
}

function decoHTML(type){
  if(type==="tree")return `<div class="deco tree"><i class="trunk"></i><i class="leaf1"></i><i class="leaf2"></i><i class="leaf3"></i></div>`;
  if(type==="sun")return `<div class="deco sun"></div>`;
  if(type==="torch")return `<div class="deco torch"><i class="stick"></i><i class="flame"></i></div>`;
  if(type==="flower")return `<div class="deco flower"><i class="stem"></i><i class="head"></i></div>`;
  if(type==="crystal")return `<div class="deco crystal"><i class="c1"></i><i class="c2"></i><i class="c3"></i></div>`;
  if(type==="mushroom")return `<div class="deco mushroom"><i class="stem"></i><i class="cap"></i></div>`;
  if(type==="star")return `<div class="deco star">★</div>`;
  if(type==="chest")return `<div class="deco chest"><i class="lid"></i><i class="box"></i><i class="lock"></i></div>`;
  if(type==="bird")return `<div class="deco bird"><i class="tail"></i><i class="body"></i><i class="wing"></i><i class="head"></i><i class="eye"></i><i class="beak"></i></div>`;
  if(type==="bee")return `<div class="deco bee"><i class="wing1"></i><i class="wing2"></i><i class="body"></i><i class="eye"></i><i class="stinger"></i></div>`;
  if(type==="frog")return `<div class="deco frog"><i class="leg1"></i><i class="leg2"></i><i class="body"></i><i class="head"></i><i class="eye1"></i><i class="eye2"></i></div>`;
  if(type==="butterfly")return `<div class="deco butterfly"><i class="wing1"></i><i class="wing2"></i><i class="wing3"></i><i class="wing4"></i><i class="body"></i><i class="dot1"></i><i class="dot2"></i><i class="dot3"></i><i class="dot4"></i></div>`;
  if(type==="bush")return `<div class="deco bush"><i class="b1"></i><i class="b2"></i><i class="b3"></i></div>`;
  if(type==="cloud")return `<div class="deco cloud"><i class="c1"></i><i class="c2"></i><i class="c3"></i></div>`;
  if(type==="pumpkin")return `<div class="deco pumpkin"><i class="body"></i><i class="stem"></i></div>`;
  if(type==="rainbow")return `<div class="deco rainbow"></div>`;
  return "";
}

function renderDecoButtons(){
  const holder=$("decoButtons");
  if(!holder)return;
  holder.innerHTML="";
  DECOS.forEach(deco=>{
    const count=state.decorations[deco.id]||0;
    const unlocked=state.totalStars>=(deco.unlock||0);
    const btn=document.createElement("button");
    btn.className=`deco-btn${selectedDeco===deco.id&&!decoRemoveMode?" selected":""}`;
    btn.disabled=!unlocked || count<=0;
    btn.innerHTML=`<div class="deco-mini-wrap">${deco.symbol}</div>${deco.label}<small>${unlocked?`${count} verfügbar`:`ab ${deco.unlock} ⭐`}</small>`;
    btn.onclick=()=>{
      if(!unlocked || count<=0)return;
      selectedDeco=deco.id;
      decoRemoveMode=false;
      $("removeDecoBtn").classList.remove("active");
      renderDecoButtons();
      renderDecorations();
      buildStatus(`${deco.label} gewählt: Tippe oben in der Bauwelt auf einen freien Deko-Platz.`);
    };
    holder.appendChild(btn);
  });
}

function renderDecorations(){
  document.querySelectorAll(".deco-slot").forEach((slot,i)=>{
    slot.innerHTML="";
    slot.classList.remove("deco-target","deco-remove-target");
    const type=state.placedDecos[i];
    if(type)slot.innerHTML=decoHTML(type);
    if(decoRemoveMode&&type)slot.classList.add("deco-remove-target");
    else if(selectedDeco&&!decoRemoveMode&&!type)slot.classList.add("deco-target");
  });
  renderDecoButtons();
}

function placeDecoration(index){
  const current=state.placedDecos[index];
  if(decoRemoveMode){
    if(!current){buildStatus("Hier steht keine Deko.",true);return}
    state.placedDecos[index]=null;
    state.decorations[current]=(state.decorations[current]||0)+1;
    Sound.delete();
    renderDecorations();save();
    buildStatus("Deko zurück in die Sammlung gelegt.");
    return;
  }
  if(!selectedDeco){buildStatus("Wähle zuerst eine verdiente Deko aus.",true);return}
  if(current){buildStatus("Auf diesem Platz steht schon Deko.",true);return}
  if((state.decorations[selectedDeco]||0)<=0){buildStatus("Davon hast du gerade keine mehr.",true);renderDecorations();return}
  state.decorations[selectedDeco]--;
  state.placedDecos[index]=selectedDeco;
  Sound.build();
  renderDecorations();save();
  const label=DECOS.find(d=>d.id===selectedDeco)?.label||"Deko";
  buildStatus(`${label} platziert.`);
}

function toggleDecoRemove(){
  decoRemoveMode=!decoRemoveMode;
  selectedDeco=null;
  const btn=$("removeDecoBtn");
  btn.classList.toggle("active",decoRemoveMode);
  btn.textContent=decoRemoveMode?"Entfernen beenden":"Deko entfernen";
  renderDecorations();
  buildStatus(decoRemoveMode?"Tippe auf eine rot markierte Deko. Sie kommt zurück in deine Sammlung.":"Deko-Entfernen beendet.");
}

function renderBuild(){
  document.querySelectorAll(".build-slot").forEach((slot,i)=>{
    slot.innerHTML="";
    slot.classList.remove("delete-target","jump-gap-slot");
    const startH=elevationBefore(i),piece=state.build[i];
    slot.style.transform=`translateY(${-startH*STEP_HEIGHT}px)`;
    slot.classList.toggle("filled",!!piece);

    if(piece==="jump-gap"){
      slot.classList.add("jump-gap-slot");
      slot.classList.remove("filled");
      slot.innerHTML='<span class="jump-gap-label">SPRUNG</span>';
      if(deleteMode)slot.classList.add("delete-target");
      return;
    }

    if(piece){
      const d=document.createElement("div");
      const isLoop=piece.startsWith("loop-");
      const isTunnel=piece.startsWith("tunnel-");
      const isJump=piece.startsWith("jump-");
      const isCorkscrew=piece.startsWith("corkscrew-");
      d.className=`track-piece ${isLoop?"loop-track ":""}${isTunnel?"tunnel-track ":""}${isJump?"jump-track ":""}${isCorkscrew?"corkscrew-track ":""}${piece}`;
      if(piece==="loop-start"){
        d.innerHTML='<i></i><span class="loop-ring"></span>';
      }else if(piece==="tunnel-start"){
        d.innerHTML='<i></i><span class="rock-tunnel"></span>';
      }else if(piece==="jump-start" || piece==="jump-legacy"){
        d.innerHTML='<i></i><span class="jump-star">★</span>';
      }else if(piece==="corkscrew-start"){
        d.innerHTML='<i></i><span class="corkscrew-rings"><b></b><b></b><b></b></span>';
      }else{
        d.innerHTML="<i></i>";
      }
      slot.appendChild(d);
      if(deleteMode)slot.classList.add("delete-target")
    }
  });
  renderDecorations();
  updateUI();
  positionBuilderTunnel()
}
function pieceCost(piece){
  if(piece==="bridge")return{rail:1,wood:1};
  if(piece==="boost")return{rail:1,emerald:1};
  if(piece==="tunnel")return{rail:3,stone:3,pickaxe:1};
  if(piece==="loop")return{rail:5,gold:2};
  if(piece==="jump")return{rail:2,wood:1};
  if(piece==="corkscrew")return{rail:4,gold:2};
  return{rail:1}
}
function canAfford(cost){return Object.entries(cost).every(([k,v])=>state.items[k]>=v)}
function spend(cost){Object.entries(cost).forEach(([k,v])=>state.items[k]-=v)}

function deletePiece(index){
  if(!state.build[index]){buildStatus("Hier ist kein Streckenteil zum Löschen.",true);return}

  if(String(state.build[index]).startsWith("loop-")){
    while(index>0 && state.build[index]!=="loop-start")index--;
    for(let i=index;i<state.build.length;i++)state.build[i]=null;
    buildStatus("Looping und alle Streckenteile rechts davon gelöscht. Materialien werden nicht zurückgegeben.");
    Sound.delete();renderBuild();save();return
  }

  if(String(state.build[index]).startsWith("tunnel-")){
    while(index>0 && state.build[index]!=="tunnel-start")index--;
    for(let i=index;i<state.build.length;i++)state.build[i]=null;
    buildStatus("Tunnel und alle Streckenteile rechts davon gelöscht. Materialien werden nicht zurückgegeben.");
    Sound.delete();renderBuild();save();return
  }

  if(String(state.build[index]).startsWith("jump-") && state.build[index]!=="jump-legacy"){
    while(index>0 && state.build[index]!=="jump-start")index--;
    for(let i=index;i<state.build.length;i++)state.build[i]=null;
    buildStatus("Sprung und alle Streckenteile rechts davon gelöscht. Materialien werden nicht zurückgegeben.");
    Sound.delete();renderBuild();save();return
  }

  if(String(state.build[index]).startsWith("corkscrew-")){
    while(index>0 && state.build[index]!=="corkscrew-start")index--;
    for(let i=index;i<state.build.length;i++)state.build[i]=null;
    buildStatus("Korkenzieher und alle Streckenteile rechts davon gelöscht. Materialien werden nicht zurückgegeben.");
    Sound.delete();renderBuild();save();return
  }

  const hasPiecesAfter=state.build.slice(index+1).some(Boolean);
  if(hasPiecesAfter){
    for(let i=index;i<state.build.length;i++)state.build[i]=null;
    buildStatus("Teil und alle Teile rechts davon gelöscht. Materialien werden nicht zurückgegeben.")
  }else{
    state.build[index]=null;buildStatus("Streckenteil gelöscht. Material ist verbraucht.")
  }
  Sound.delete();renderBuild();save()
}
function toggleDeleteMode(){
  deleteMode=!deleteMode;
  const btn=$("deleteModeBtn");
  btn.classList.toggle("delete-active",deleteMode);
  btn.textContent=deleteMode?"Löschen beenden":"Teil löschen";
  if(deleteMode){
    document.querySelectorAll(".build-btn[data-piece]").forEach(b=>b.classList.remove("selected"));
    buildStatus("Löschmodus aktiv: Tippe auf ein rot markiertes Teil.")
  }else{
    const current=document.querySelector(`.build-btn[data-piece="${selectedPiece}"]`);
    if(current)current.classList.add("selected");
    buildStatus("Löschmodus beendet.")
  }
  renderBuild()
}
function clearTrack(){
  if(!state.build.some(Boolean)){buildStatus("Deine Strecke ist schon leer.");return}
  const btn=$("clearTrackBtn");
  if(!clearArmed){
    clearArmed=true;btn.textContent="Wirklich alles löschen?";btn.classList.add("delete-active");
    buildStatus("Tippe innerhalb von 4 Sekunden noch einmal zum Bestätigen.",true);
    if(clearTimer)clearTimeout(clearTimer);
    clearTimer=setTimeout(()=>{
      clearArmed=false;btn.textContent="Alles löschen";btn.classList.remove("delete-active");
      buildStatus("Löschen abgebrochen.")
    },4000);
    return
  }
  if(clearTimer)clearTimeout(clearTimer);
  clearArmed=false;
  state.build=Array(BUILD_SLOT_COUNT).fill(null);
  deleteMode=false;
  $("deleteModeBtn").classList.remove("delete-active");$("deleteModeBtn").textContent="Teil löschen";
  btn.textContent="Alles löschen";btn.classList.remove("delete-active");
  Sound.delete();renderBuild();save();
  buildStatus("Die komplette Strecke wurde gelöscht. Materialien sind weg.")
}

function placePiece(index){
  if(deleteMode){deletePiece(index);return}
  if(state.build[index])return;
  if(index>0&&!state.build[index-1]){buildStatus("Baue die Strecke von links nach rechts weiter.",true);return}
  const h=elevationBefore(index);

  if(selectedPiece==="tunnel"){
    if(index+2>=state.build.length){
      buildStatus("Für den Tunnel brauchst du drei freie Bauplätze hintereinander.",true);
      return
    }
    if(state.build.slice(index,index+3).some(Boolean)){
      buildStatus("Der Tunnel braucht drei freie Bauplätze hintereinander.",true);
      return
    }
    if(h>1){
      buildStatus("Der Tunnel ist hier zu hoch. Baue ihn auf Bodenhöhe oder nur eine Stufe erhöht.",true);
      return
    }
    const tunnelCost=pieceCost("tunnel");
    if(!canAfford(tunnelCost)){
      buildStatus("Für einen Tunnel brauchst du 3 Schienen, 3 Stein und 1 Spitzhacke.",true);
      return
    }
    spend(tunnelCost);
    state.build[index]="tunnel-start";
    state.build[index+1]="tunnel-mid";
    state.build[index+2]="tunnel-end";
    Sound.tunnelBuild();
    renderBuild();save();
    buildStatus("Tunnel gebaut! Die Lore fährt jetzt durch den Felsen. ⛏️");
    return
  }

  if(selectedPiece==="loop"){
    if(index===0 || state.build[index-1]!=="boost"){
      buildStatus("Für den Looping muss direkt davor ein Booster liegen – sonst fehlt der Lore der Schwung!",true);
      return
    }
    if(index+4>=state.build.length){
      buildStatus("Für den Looping brauchst du noch fünf freie Bauplätze hintereinander.",true);
      return
    }
    if(state.build.slice(index,index+5).some(Boolean)){
      buildStatus("Der Looping braucht fünf freie Bauplätze hintereinander.",true);
      return
    }
    if(h>1){
      buildStatus("Der Looping ist hier zu hoch. Baue ihn auf Bodenhöhe oder nur eine Stufe erhöht.",true);
      return
    }
    const loopCost=pieceCost("loop");
    if(!canAfford(loopCost)){
      buildStatus("Für einen Looping brauchst du 5 Schienen und 2 Gold.",true);
      return
    }
    spend(loopCost);
    state.build[index]="loop-start";
    state.build[index+1]="loop-1";
    state.build[index+2]="loop-2";
    state.build[index+3]="loop-3";
    state.build[index+4]="loop-end";
    Sound.loopBuild();
    renderBuild();save();
    buildStatus("Looping gebaut! Der Booster davor gibt der Lore genug Schwung. 🎢");
    return
  }

  if(selectedPiece==="corkscrew"){
    if(index===0 || state.build[index-1]!=="boost"){
      buildStatus("Für den Korkenzieher muss direkt davor ein Booster liegen.",true);
      return
    }
    if(index+3>=state.build.length){
      buildStatus("Für den Korkenzieher brauchst du vier freie Bauplätze hintereinander.",true);
      return
    }
    if(state.build.slice(index,index+4).some(Boolean)){
      buildStatus("Der Korkenzieher braucht vier freie Bauplätze hintereinander.",true);
      return
    }
    if(h>1){
      buildStatus("Der Korkenzieher ist hier zu hoch. Baue ihn auf Bodenhöhe oder nur eine Stufe erhöht.",true);
      return
    }
    const corkCost=pieceCost("corkscrew");
    if(!canAfford(corkCost)){
      buildStatus("Für einen Korkenzieher brauchst du 4 Schienen und 2 Gold.",true);
      return
    }
    spend(corkCost);
    state.build[index]="corkscrew-start";
    state.build[index+1]="corkscrew-1";
    state.build[index+2]="corkscrew-2";
    state.build[index+3]="corkscrew-end";
    Sound.corkscrewBuild();
    renderBuild();save();
    buildStatus("Seitlicher Looping gebaut! Jetzt dreht sich die Lore wie im Korkenzieher. 🌀");
    return
  }

  if(selectedPiece==="jump"){
    if(index+2>=state.build.length){
      buildStatus("Für den Sprung brauchst du drei Bauplätze: Rampe, Lücke und Landung.",true);
      return
    }
    if(state.build.slice(index,index+3).some(Boolean)){
      buildStatus("Der Sprung braucht drei freie Bauplätze hintereinander.",true);
      return
    }
    const jumpCost=pieceCost("jump");
    if(!canAfford(jumpCost)){
      buildStatus("Für einen Sprung brauchst du 2 Schienen und 1 Holz.",true);
      return
    }
    spend(jumpCost);
    state.build[index]="jump-start";
    state.build[index+1]="jump-gap";
    state.build[index+2]="jump-land";
    Sound.jumpBuild();
    renderBuild();save();
    buildStatus("Sprung gebaut! Das mittlere Feld bleibt frei – die Lore springt wirklich darüber. ⭐");
    return
  }

  if(selectedPiece==="down"&&h<=0){buildStatus("Hier kannst du noch nicht bergab fahren – baue zuerst bergauf.",true);return}
  if(selectedPiece==="up"&&h>=3){buildStatus("Höher geht es in diesem Baugebiet gerade nicht.",true);return}
  const cost=pieceCost(selectedPiece);
  if(!canAfford(cost)){
    if(selectedPiece==="jump") buildStatus("Für einen Sprung brauchst du 2 Schienen und 1 Holz.",true);
    else buildStatus("Dafür fehlen dir noch Materialien.",true);
    return
  }
  spend(cost);state.build[index]=selectedPiece;
  Sound.build();renderBuild();save();
  buildStatus("Streckenteil gesetzt.")
}
