  corkscrewRide(){this.tone(420,.07,"triangle",.02);this.tone(620,.07,"triangle",.021,.06);this.tone(820,.08,"triangle",.022,.12);this.tone(1040,.12,"triangle",.022,.20)},
  tunnelBuild(){this.tone(210,.07,"square",.025);this.tone(285,.07,"square",.025,.08);this.tone(190,.09,"triangle",.022,.16);this.tone(340,.12,"square",.02,.25)},
  tunnelRide(){this.tone(180,.12,"triangle",.018);this.tone(150,.16,"triangle",.016,.10);this.tone(220,.10,"triangle",.014,.24)},
