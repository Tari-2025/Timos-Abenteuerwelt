    h=`<h2>${svgIcon("i-profile","icon-lg")} ${CONFIG.playerName}</h2><p>Sterne: <b>${state.totalStars}</b></p><p>Level: <b>${state.levelIndex+1}</b> / ${CONFIG.levels.length}</p>`
  }
  if(kind==="map"){
    const items=CONFIG.levels.map((lvl,i)=>{
      const now = i===state.levelIndex ? " style=\"color:#ffd23f;font-weight:1000\"" : "";
      const tag = lvl.boss ? " — <b>Boss</b>" : (lvl.subtitle ? ` – ${lvl.subtitle}` : "");
      return `<li${now}>Level ${i+1}: ${lvl.title}${tag}</li>`;
    }).join("");
    h=`<h2>${svgIcon("i-map","icon-lg")} Karte</h2><div style="max-height:52vh;overflow:auto"><ol style="text-align:left;display:inline-block;margin:0;padding-left:20px">${items}</ol></div>`
  }
  if(kind==="book"){
    h=`<h2>${svgIcon("i-book","icon-lg")} So geht's</h2><p>Rechnen → Materialien sammeln → Strecke bauen → Lore fahren lassen.</p><p>Es gibt Plus-/Minus-Welten, eine <b>Rätselhöhle</b> mit Lückenaufgaben (z. B. 7 + ? = 12), ein <b>Dorf</b> mit Minecraft-Textaufgaben und die Weltraum-Level mit dem Einmaleins.</p><p><b>Boss-Level:</b> Nach je drei Welten wartet ein Gegner (Creeper, Zombie, Skelett, Spinne … und am Ende der Enderdrache). Statt zu fahren, besiegst du ihn, indem du Lücken- und Textaufgaben löst – jede richtige Antwort ist ein Treffer!</p><p>Im Baubereich wird alle 20 Sterne ein neuer Hintergrund freigeschaltet. Manche Deko ist häufig, andere seltener und manche gibt es erst ab einer bestimmten Sternzahl. So kannst du mit der Zeit immer mehr sammeln und platzieren.</p><p><b>Tunnel:</b> Er braucht 3 freie Bauplätze, 3 Schienen, 3 Stein und 1 Spitzhacke. Die Lore fährt sichtbar durch den Felsen.</p><p><b>Looping:</b> Er braucht 5 freie Bauplätze, 5 Schienen und 2 Gold. Direkt davor muss ein Booster liegen, damit die Lore genug Schwung hat.</p><p><b>Sprungschanze:</b> Sie kostet 2 Schienen und 1 Holz und belegt drei Felder: Rampe, echte freie Lücke und Landung.</p><p><b>Korkenzieher:</b> Das ist Timos seitlicher Looping. Er braucht 4 freie Bauplätze, 4 Schienen, 2 Gold und direkt davor einen Booster.</p>`
  }
  if(kind==="settings"){
    h=`<h2>${svgIcon("i-gear","icon-lg")} Einstellungen</h2><p>Mit dem Lautsprecher oben kannst du den Ton an- und ausschalten.</p><p>Die große Szene ändert sich mit dem Level. Die Bau-Hintergründe können weiterhin separat gewählt werden.</p>`
  }
  $("modalContent").innerHTML=h;$("modal").classList.add("open")
}
function showCollection(){
  const labels={
    wood:["i-wood","Holz"],stone:["i-stone","Stein"],rail:["i-rail","Schiene"],emerald:["i-emerald","Smaragd"],gold:["i-gold","Gold"],pickaxe:["i-pickaxe","Spitzhacke"]
  };
  const materialHtml=Object.entries(state.items).map(([id,n])=>`<div class="item">${svgIcon(labels[id][0],"icon-lg")}<strong>${n}</strong><span>${labels[id][1]}</span></div>`).join("");
  const decoHtml=DECOS.map(d=>{
