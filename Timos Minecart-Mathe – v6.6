.theme-picker-wrap{margin-top:10px;display:flex;flex-direction:column;gap:8px;align-items:center}
.theme-picker-label{font-size:14px;color:#e8efe8;font-weight:800}
.theme-picker{display:flex;gap:8px;flex-wrap:wrap;justify-content:center}
.theme-btn{
  min-width:86px;padding:8px 10px;background:linear-gradient(#394039,#2a302b);color:#fff;border:3px solid #5e685f;border-radius:10px;box-shadow:0 4px 0 #101310;cursor:pointer;font-weight:800;font-size:13px
}
.theme-btn small{display:block;font-size:10px;color:#c8d1ca;font-weight:700;margin-top:2px}
.theme-btn.active{outline:3px solid var(--gold);background:#454d45}
.theme-btn.locked{opacity:.55;filter:grayscale(.25);cursor:not-allowed}
.build-grid{
  position:absolute;left:3%;right:3%;bottom:64px;height:164px;
  display:grid;grid-template-columns:repeat(24,1fr);gap:7px;align-items:end;z-index:3
}
.build-slot{
  position:relative;height:76px;border:3px dashed rgba(255,255,255,.36);border-radius:8px;
  display:flex;align-items:end;justify-content:center;background:rgba(0,0,0,.08);
  transition:transform .3s ease
}
.build-slot::before{
  content:"Hier bauen";position:absolute;top:7px;left:0;right:0;text-align:center;
  font-size:10px;color:rgba(255,255,255,.55)
}
.build-slot.filled{border-style:solid;border-color:#4f5a51;background:rgba(0,0,0,.12)}
.build-slot.filled::before{content:""}
.build-slot.delete-target{box-shadow:inset 0 0 0 3px rgba(231,107,97,.55)}
.track-piece{width:100%;height:38px;position:relative}
.track-piece::before,.track-piece::after{
  content:"";position:absolute;left:5%;right:5%;height:6px;background:#a6aca8;border:1px solid #3f443f
}
.track-piece::before{top:7px}.track-piece::after{bottom:7px}
.track-piece i{position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 14px,#6b4428 14px 21px,transparent 21px 29px)}
.track-piece.up{transform:rotate(-11deg);transform-origin:left center}
.track-piece.down{transform:rotate(11deg);transform-origin:left center}
.track-piece.boost::before,.track-piece.boost::after{background:#efbb37;box-shadow:0 0 8px rgba(239,187,55,.38)}
.track-piece.bridge{
  bottom:24px;
  filter:drop-shadow(0 8px 0 rgba(75,52,32,.8));
}

/* Five-slot roller-coaster loop */
.track-piece.loop-track::before,.track-piece.loop-track::after{
  background:#c7ced0;
  box-shadow:0 0 0 1px #50585a;
}
.track-piece.loop-track i{
  background:
    repeating-linear-gradient(90deg,transparent 0 13px,#77502e 13px 20px,transparent 20px 28px);
}
.track-piece.loop-start{z-index:8}
.loop-ring{
  position:absolute;
  pointer-events:none;
  left:calc(100% + 7px);
  bottom:9px;
  width:calc(300% + 14px);
  height:152px;
  border:7px solid #bfc7c9;
  border-radius:50%;
  box-shadow:
    inset 0 0 0 5px #77502e,
    inset 0 0 0 10px #c8d0d2,
    0 4px 0 rgba(0,0,0,.24);
  z-index:20;
}
.loop-ring::before{
  content:"";
  position:absolute;
  inset:-15px;
  border:5px dashed #e2ba39;
  border-radius:50%;
  opacity:.96;
}
.loop-ring::after{
  content:"GOLD-LOOP";
  position:absolute;
  left:50%;
  top:-30px;
  transform:translateX(-50%);
  white-space:nowrap;
  padding:4px 8px;
  color:#2a210b;
  background:#f2c94b;
  border:3px solid #7b5b17;
  font-size:10px;
  font-weight:1000;
  box-shadow:0 3px 0 #3c2c0d;
}
.loop-btn{
  background:linear-gradient(#6b5723,#433817);
  border-color:#d5ae36;
}
.loop-btn.selected{
  outline-color:#ffe16a;
  background:linear-gradient(#8a722b,#55451a);
}
.jump-btn{
  background:linear-gradient(#7a5c38,#4f391f);
  border-color:#d3a56a;
}
.jump-btn.selected{
  outline-color:#f6d39a;
  background:linear-gradient(#8f6e42,#5f4727);
}
.track-piece.jump::before,.track-piece.jump::after{left:10%;right:14%}
.track-piece.jump i{clip-path:polygon(0 100%,62% 100%,100% 34%,100% 10%,74% 10%,52% 54%,0 54%);background:linear-gradient(180deg,#8a6136,#5f3f22)}
.track-piece.jump .jump-star{position:absolute;right:3px;top:-12px;color:#ffd866;font-size:14px;text-shadow:0 0 6px rgba(255,216,102,.65)}

/* Echter Sprung: Rampe + freie Lücke + Landung */
.build-slot.jump-gap-slot{
  border-style:dashed;
  border-color:rgba(255,216,102,.58);
  background:rgba(255,216,102,.035);
}
.build-slot.jump-gap-slot::before{content:"LÜCKE";color:#ffe28a;font-size:10px}
.jump-gap-label{
  position:absolute;left:50%;bottom:7px;transform:translateX(-50%);
  color:#ffe28a;font-size:9px;font-weight:1000;letter-spacing:.4px;
}
.track-piece.jump-start::before,.track-piece.jump-start::after{
  left:8%;right:3%;transform:rotate(-18deg);transform-origin:left center;
}
.track-piece.jump-start i{
  clip-path:polygon(0 100%,42% 100%,100% 20%,100% 0,72% 0,38% 55%,0 55%);
  background:linear-gradient(180deg,#9a7044,#5f3f22);
}
.track-piece.jump-land::before,.track-piece.jump-land::after{
  left:3%;right:8%;transform:rotate(13deg);transform-origin:right center;
}
.track-piece.jump-land i{
  clip-path:polygon(0 20%,58% 100%,100% 100%,100% 55%,62% 55%,28% 0,0 0);
  background:linear-gradient(180deg,#9a7044,#5f3f22);
}

/* Seitlicher Looping / Korkenzieher */
.corkscrew-btn{
  background:linear-gradient(#5e467c,#38284d);
  border-color:#ac84d6;
}
.corkscrew-btn.selected{
  outline-color:#d9b8ff;
  background:linear-gradient(#725594,#49335f);
}
.track-piece.corkscrew-track::before,
.track-piece.corkscrew-track::after{
  background:#c8d0d3;
  box-shadow:0 0 0 1px #50585a;
}
.track-piece.corkscrew-track i{
  background:repeating-linear-gradient(90deg,transparent 0 13px,#77502e 13px 20px,transparent 20px 28px);
}
.track-piece.corkscrew-start{z-index:9}
.corkscrew-rings{
  position:absolute;
  pointer-events:none;
  left:calc(100% + 3px);
  bottom:0;
  width:calc(300% + 18px);
  height:110px;
  z-index:22;
}
.corkscrew-rings b{
  position:absolute;
  top:7px;
  width:42%;
  height:84px;
  border:7px solid #c8d1d5;
  border-radius:50%;
  box-shadow:inset 0 0 0 4px #76502f,0 4px 0 rgba(0,0,0,.22);
  transform:skewX(-18deg) rotate(-8deg);
}
.corkscrew-rings b:nth-child(1){left:0}
.corkscrew-rings b:nth-child(2){left:29%;top:13px;transform:skewX(18deg) rotate(8deg)}
.corkscrew-rings b:nth-child(3){right:0}
.corkscrew-rings::after{
  content:"KORKENZIEHER";
  position:absolute;
  left:50%;top:-22px;transform:translateX(-50%);
  white-space:nowrap;
  padding:4px 8px;
  color:#21152f;
  background:#cfadf2;
  border:3px solid #6c4a91;
  font-size:10px;font-weight:1000;
  box-shadow:0 3px 0 #2b1d39;
}
.builder-cart{transform-style:preserve-3d}
.loop-boost-warning{
  animation:loopPulse .7s ease-in-out 2;
}
@keyframes loopPulse{
  50%{filter:drop-shadow(0 0 12px rgba(255,213,72,.95))}
}


/* Three-slot rock tunnel */
.track-piece.tunnel-track::before,
.track-piece.tunnel-track::after{
  background:#a9b0ad;
}
.track-piece.tunnel-track i{
  background:repeating-linear-gradient(90deg,transparent 0 13px,#6c4529 13px 20px,transparent 20px 28px);
}
.track-piece.tunnel-start{z-index:8}
.rock-tunnel{
  position:absolute;
  pointer-events:none;
  left:-3%;
  bottom:-1px;
  width:calc(300% + 14px);
  height:112px;
  border:12px solid #626a66;
  border-bottom:0;
  border-radius:56px 56px 0 0;
  box-shadow:
    inset 0 0 0 5px #323834,
    0 6px 0 rgba(0,0,0,.28),
    0 0 0 3px #2a2f2b;
  z-index:4;
}
.rock-tunnel::before{
  content:"";
  position:absolute;
  inset:9px 10px 0;
  border:4px solid #252a27;
  border-bottom:0;
  border-radius:42px 42px 0 0;
  background:
    linear-gradient(90deg,rgba(255,255,255,.06) 1px,transparent 1px) 0 0/22px 22px,
    linear-gradient(rgba(255,255,255,.04) 1px,transparent 1px) 0 0/22px 22px,
    rgba(18,22,19,.18);
}
.rock-tunnel::after{
  content:"TUNNEL";
  position:absolute;
  left:50%;
  top:-31px;
  transform:translateX(-50%);
  padding:4px 8px;
  white-space:nowrap;
  color:#e9eee9;
  background:#4e5651;
  border:3px solid #252b27;
  font-size:10px;
  font-weight:1000;
  box-shadow:0 3px 0 rgba(0,0,0,.35);
}
.tunnel-btn{
  background:linear-gradient(#565e59,#363c38);
  border-color:#818a84;
}
.tunnel-btn.selected{
  outline-color:#cdd5d0;
  background:linear-gradient(#68716b,#414844);
}

/* mini cart */
.builder-cart{
  position:absolute;left:5%;bottom:90px;width:108px;height:82px;z-index:5;
  will-change:left,bottom,transform;
  filter:drop-shadow(0 6px 0 rgba(0,0,0,.22));
}
.builder-cart-sparkles{
  position:absolute;left:4px;right:8px;bottom:8px;height:10px;pointer-events:none;
}
.builder-cart-sparkles::before,.builder-cart-sparkles::after{
  content:"";position:absolute;width:7px;height:7px;background:#ffe37b;
  box-shadow:10px 4px 0 #fff3b0,22px 1px 0 #ffe37b,54px 4px 0 #fff3b0,70px 0 0 #ffe37b;
  opacity:.72;animation:builderTwinkle 2.1s ease-in-out infinite;
}
.builder-cart-sparkles::after{
  left:18px;bottom:1px;transform:scale(.82);
  animation-delay:1.1s;
}
@keyframes builderTwinkle{
  0%,100%{opacity:.18;transform:translateY(1px) scale(.85)}
  50%{opacity:.9;transform:translateY(-3px) scale(1)}
}

.builder-tunnel{
  position:absolute;
  right:1.2%;
  bottom:64px;
  width:92px;
  height:108px;
  z-index:4;
  pointer-events:none;
  transition:bottom .35s ease;
}
.builder-tunnel .stone-shell{
  position:absolute;
  inset:0;
  background:
    linear-gradient(90deg,rgba(255,255,255,.11) 1px,transparent 1px) 0 0/22px 22px,
    linear-gradient(rgba(255,255,255,.07) 1px,transparent 1px) 0 0/22px 22px,
    #68706d;
  border:8px solid #303733;
  border-bottom:none;
  border-radius:44px 44px 0 0;
  box-shadow:0 7px 0 rgba(20,25,22,.55);
}
.builder-tunnel .mouth{
  position:absolute;
  left:20px;
  right:20px;
  bottom:0;
  height:72px;
  background:linear-gradient(180deg,#111616,#050707);
  border-radius:28px 28px 0 0;
  box-shadow:
    inset 0 0 18px rgba(0,0,0,.9),
    0 0 0 4px rgba(20,24,21,.7);
  z-index:2;
}
.builder-tunnel .lamp{
  position:absolute;
  top:6px;
  left:50%;
  width:18px;
  height:18px;
  margin-left:-9px;
  background:#f2bd45;
  border:3px solid #4b3515;
  box-shadow:0 0 12px rgba(242,189,69,.7);
  z-index:3;
}
.builder-tunnel .sign{
  position:absolute;
  left:10px;
  right:10px;
  top:-28px;
  text-align:center;
  font-size:11px;
  font-weight:1000;
  color:#f2f5f1;
  text-shadow:0 2px 0 #101310;
}
.builder-loading{
  position:absolute;
  inset:0;
  z-index:20;
  display:none;
  align-items:center;
  justify-content:center;
  flex-direction:column;
  gap:12px;
  background:rgba(7,11,14,.88);
  backdrop-filter:blur(2px);
  color:white;
  text-align:center;
  padding:24px;
}
.builder-loading.open{display:flex}
.builder-loading-title{
  font-size:clamp(22px,5vw,34px);
  font-weight:1000;
  letter-spacing:.5px;
  text-shadow:0 3px 0 #101310;
}
.builder-loading-sub{
  font-size:14px;
  color:#dce7df;
}
.loader-track{
  width:min(320px,80%);
  height:24px;
  border:4px solid #c7d0ca;
  background:#202722;
  box-shadow:0 4px 0 rgba(0,0,0,.4);
  overflow:hidden;
}
.loader-bar{
  width:0%;
  height:100%;
  background:repeating-linear-gradient(
    90deg,
    #7dd25d 0 24px,
    #5ab845 24px 48px
  );
}
.builder-loading.open .loader-bar{
  animation:mineLoad 1.55s ease-in-out forwards;
}
@keyframes mineLoad{
  0%{width:0}
  25%{width:24%}
  55%{width:58%}
  78%{width:81%}
  100%{width:100%}
}
.mini-cart{
  position:absolute;left:3px;bottom:0;width:98px;height:58px;
}
.mini-cart-body{
  position:absolute;left:10px;right:9px;top:15px;bottom:11px;
  background:
    linear-gradient(180deg,rgba(255,255,255,.18) 0 18%,transparent 18%),
    linear-gradient(#8b9490,#676f6b);
  border:4px solid #242924;
  clip-path:polygon(8% 0,92% 0,82% 100%,18% 100%);
  box-shadow:inset 0 0 0 3px rgba(255,255,255,.06),inset 0 -8px 0 rgba(0,0,0,.12);
}
.mini-cart-rim{
  position:absolute;left:20px;right:20px;top:10px;height:13px;
  background:linear-gradient(#dfe4e1,#afb6b2);
  border:3px solid #242924;
  box-shadow:0 2px 0 rgba(255,255,255,.16) inset;
}
.mini-cart-top{
  position:absolute;left:28px;right:28px;top:3px;height:11px;
  background:linear-gradient(#f2f5f2,#c9d0cb);
  border:3px solid #242924;
}
.mini-cart-seat{
  position:absolute;left:37px;right:37px;top:18px;height:10px;
  background:#5f4129;border:3px solid #2f2016;
}
.mini-cart-front,.mini-cart-back{
  position:absolute;bottom:16px;width:8px;height:18px;
  background:#7d8581;border:3px solid #242924;
}
.mini-cart-front{right:3px}
.mini-cart-back{left:3px}
.mini-cart-lamp{
  position:absolute;right:-2px;top:18px;width:12px;height:12px;
  background:#ffd35d;border:3px solid #6c5218;
  box-shadow:0 0 10px rgba(255,211,93,.5);
}
.mini-cart-lamp::after{
  content:"";position:absolute;left:2px;top:2px;width:4px;height:4px;background:#fff5bf;
}
.mini-cart-flag{
  position:absolute;left:12px;top:-9px;width:4px;height:20px;background:#47311f;border:1px solid #27180f;
}
.mini-cart-flag::after{
  content:"";position:absolute;left:3px;top:1px;width:13px;height:10px;
  background:#45b655;border:2px solid #215e2b;clip-path:polygon(0 0,100% 18%,74% 100%,0 100%);
}
.mini-wheel{
  position:absolute;bottom:0;width:20px;height:20px;
  background:
    radial-gradient(circle at 50% 50%,#69706c 0 30%,#3d433f 31% 58%,#1f2420 59% 100%);
  border:3px solid #252a26;border-radius:50%;
  box-shadow:0 0 0 2px #59605c inset,0 2px 0 rgba(255,255,255,.08) inset;
}
.mini-wheel-core{
  position:absolute;left:50%;top:50%;width:5px;height:5px;margin-left:-2.5px;margin-top:-2.5px;
  background:#cfd5d1;border:2px solid #242924;border-radius:50%;
}
.mw1{left:18px}.mw2{right:18px}
.mini-rider{
  position:absolute;left:30px;top:-17px;width:40px;height:36px;z-index:3;
}
.mini-rider-head{
  position:absolute;left:10px;top:2px;width:20px;height:19px;background:#d9a26c;border:3px solid #211712;
  box-shadow:inset 0 2px 0 rgba(255,255,255,.12);
}
.mini-rider-hair{
  position:absolute;left:8px;top:-1px;width:24px;height:9px;background:#6a3f25;border:3px solid #211712;
  border-bottom:none;
}
.mini-rider-cap{
  position:absolute;left:12px;top:-6px;width:16px;height:8px;background:#f0ca4f;border:3px solid #7e621d;
}
.mini-eye{
  position:absolute;top:7px;width:3px;height:3px;background:#15120f;border-radius:50%;
}
.me1{left:5px}.me2{right:5px}
.mini-mouth{
  position:absolute;left:6px;right:6px;bottom:3px;height:3px;background:#8d4f3d;
}
.mini-rider-body{
  position:absolute;left:9px;top:20px;width:22px;height:14px;background:#3874c8;border:3px solid #211712;border-top:none;
  box-shadow:inset 0 2px 0 rgba(255,255,255,.12);
}
.mini-rider-body::after{
  content:"";position:absolute;left:8px;top:0;width:3px;height:14px;background:#7db2ff;
}
.mini-rider-arm{
  position:absolute;top:21px;width:7px;height:14px;background:#d9a26c;border:3px solid #211712;border-top:none;
}
.ma1{left:3px;transform:rotate(12deg)}
.ma2{right:3px;transform:rotate(-12deg)}

.resourcebar{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin:10px 0 0}
.resource{
  display:flex;align-items:center;gap:6px;padding:7px 10px;
  background:#151915;border:2px solid #4d574f;border-radius:8px;font-weight:800
}
.build-controls{display:flex;gap:8px;flex-wrap:wrap;justify-content:center;margin-top:12px}
.build-btn{
  padding:9px 12px;background:linear-gradient(#383f39,#2d332e);
  border:3px solid #5e685f;border-radius:9px;color:#fff;cursor:pointer;font-weight:800;
  box-shadow:0 4px 0 #101310
}
.build-btn.selected{outline:3px solid var(--gold);background:#444d45}
.build-btn.delete-active{outline:3px solid #ff857a;background:#58322f}
.build-btn .cost{display:block;margin-top:2px;font-size:11px;color:#d5ddd7;font-weight:600}
.ride-btn{background:linear-gradient(#79df48,#43a724);border-color:#2a7316}
.tip{font-size:13px;color:#d5ddd5;text-align:center;margin-top:8px}

/* ---------- MODALS ---------- */
.overlay{
  position:fixed;inset:0;z-index:40;display:none;align-items:center;justify-content:center;
  padding:18px;background:rgba(0,0,0,.73)
}
.overlay.open{display:flex}
.dialog{
  position:relative;width:min(560px,95vw);padding:26px;text-align:center;
  background:#242a25;border:6px solid #657068;outline:3px solid #0d100d;border-radius:16px;
  box-shadow:0 16px 46px rgba(0,0,0,.56)
}
.close{position:absolute;right:10px;top:6px;background:transparent;border:none;color:#fff;font-size:32px;cursor:pointer}
.dialog h2{font-size:36px;margin:4px 0 10px}.dialog p{font-size:19px;line-height:1.4}
.big-icon{width:74px;height:74px;margin:0 auto 8px;display:grid;place-items:center}
.bonus{font-size:18px;font-weight:900;margin:14px 0;display:flex;align-items:center;justify-content:center;gap:10px}
.collection{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
.collection .item{
  display:flex;flex-direction:column;align-items:center;gap:5px;
  padding:14px;background:#161a16;border:3px solid #4f5951;border-radius:10px
}
.collection .item strong{font-size:18px}.collection .item span{font-size:12px;color:#d7ddd7}

/* ---------- MOBILE ---------- */
@media(max-width:850px){
  .main-grid{grid-template-columns:56px 1fr}
  .task{grid-column:2}
  .scene{min-height:302px}
  .sidebtn{width:50px;height:50px}
}
@media(max-width:600px){
  .app{padding:6px}
  .brand{margin-bottom:8px}
  .brand-title{font-size:clamp(28px,9vw,44px);gap:5px}
  .brand-icon{width:44px;height:44px}
  .game-window{border-width:5px}
  .topbar{padding:10px 11px;align-items:flex-start}
  .level-title{max-width:72%}
  .main-grid{grid-template-columns:1fr;padding:9px}
  .scene,.task{grid-column:1}.scene{min-height:245px}
  .sidebar{grid-row:3;flex-direction:row;justify-content:center}
  .sidebtn{width:46px;height:46px}
  .question{font-size:clamp(38px,13vw,58px)}
  .answer{font-size:44px}
  .hud{justify-content:center}
  .inventory{order:3;flex-basis:100%;overflow-x:auto}
  .slot{min-width:46px;width:46px;height:46px}
  .build-area{min-height:286px}
  .build-grid{left:3%;right:3%;grid-template-columns:repeat(24,1fr);gap:4px}
  .build-slot{height:64px}
  .collection{grid-template-columns:repeat(2,1fr)}
}

/* ===================================================================== */
/* ==========  v6.0  – MEHR LEBEN & GIMMICKS (rein additiv)  =========== */
/* ===================================================================== */

/* ---- reusable step wiggle (used by pet + critters) ---- */
@keyframes stepA{0%,100%{transform:translateY(0)}50%{transform:translateY(-2px)}}
@keyframes stepB{0%,100%{transform:translateY(-2px)}50%{transform:translateY(0)}}
@keyframes hop{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}

/* ---- HELD IN DER LORE: freut sich / wackelt ---- */
#cartWrap .rider{transition:transform .15s}
#cartWrap .rider-arm{
  transform-origin:50% 100%;
  top:28px;
  width:7px;
  height:16px;
}
#cartWrap .rider.cheer{animation:riderCheer .78s ease}
@keyframes riderCheer{
  0%{transform:translateY(0)}
  20%{transform:translateY(-16px)}
  42%{transform:translateY(-5px)}
  60%{transform:translateY(-11px)}
  100%{transform:translateY(0)}
}
#cartWrap .rider.cheer .ra1{animation:armUpL .78s cubic-bezier(.2,.85,.2,1)}
#cartWrap .rider.cheer .ra2{animation:armUpR .78s cubic-bezier(.2,.85,.2,1)}
@keyframes armUpL{
  0%,100%{transform:translate(0,0) rotate(0deg)}
  18%{transform:translate(-3px,-17px) rotate(-8deg)}
  34%,72%{transform:translate(-5px,-29px) rotate(-12deg)}
  88%{transform:translate(-3px,-14px) rotate(-7deg)}
}
@keyframes armUpR{
  0%,100%{transform:translate(0,0) rotate(0deg)}
  18%{transform:translate(3px,-17px) rotate(8deg)}
  34%,72%{transform:translate(5px,-29px) rotate(12deg)}
  88%{transform:translate(3px,-14px) rotate(7deg)}
}
#cartWrap .rider.oops{animation:riderOops .55s ease}
@keyframes riderOops{0%,100%{transform:rotate(0)}25%{transform:rotate(-8deg)}60%{transform:rotate(6deg)}}

/* ---- HAUSTIER (Wolf/Hund) läuft neben der Lore ---- */
#cartWrap .pet{position:absolute;left:-46px;bottom:0;width:46px;height:32px;z-index:5;pointer-events:none;image-rendering:pixelated;animation:petBob .46s ease-in-out infinite}
@keyframes petBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-3px)}}
#cartWrap .pet.happy{animation:petHappy .6s ease}
@keyframes petHappy{0%{transform:translateY(0)}30%{transform:translateY(-18px)}55%{transform:translateY(0)}75%{transform:translateY(-9px)}100%{transform:translateY(0)}}
#cartWrap .pet .body{position:absolute;left:4px;bottom:6px;width:30px;height:14px;background:#b7bdc1;border:3px solid #3a3f42;border-radius:5px}
#cartWrap .pet .head{position:absolute;left:24px;bottom:11px;width:16px;height:14px;background:#c4cacd;border:3px solid #3a3f42;border-radius:4px}
#cartWrap .pet .ear{position:absolute;left:25px;bottom:22px;width:5px;height:7px;background:#c4cacd;border:2px solid #3a3f42}
#cartWrap .pet .ear.e2{left:33px}
#cartWrap .pet .snout{position:absolute;left:39px;bottom:13px;width:6px;height:5px;background:#3a3f42}
#cartWrap .pet .eye{position:absolute;left:30px;bottom:18px;width:3px;height:3px;background:#15181a}
#cartWrap .pet .tail{position:absolute;left:-3px;bottom:12px;width:10px;height:6px;background:#b7bdc1;border:3px solid #3a3f42;transform-origin:right center;animation:petTail .38s ease-in-out infinite}
@keyframes petTail{0%,100%{transform:rotate(-14deg)}50%{transform:rotate(20deg)}}
#cartWrap .pet .leg{position:absolute;bottom:0;width:6px;height:7px;background:#a9afb3;border:2px solid #3a3f42}
#cartWrap .pet .l1{left:8px;animation:stepA .3s linear infinite}
#cartWrap .pet .l2{left:24px;animation:stepB .3s linear infinite}

/* ---- KRITTER: laufende/fliegende Tiere im Hintergrund ---- */
.critter{position:absolute;bottom:96px;left:-12%;z-index:1;pointer-events:none;image-rendering:pixelated;display:none}
.scene:not(.cave):not(.space) .critter.pig{display:block;animation:walkAcross 19s linear 0s infinite, hop .5s ease-in-out infinite}
.scene:not(.cave):not(.space) .critter.chicken{display:block;animation:walkAcross 15s linear -7s infinite, hop .34s ease-in-out infinite}
@keyframes walkAcross{from{left:-12%}to{left:112%}}

/* Schwein */
.critter.pig{width:46px;height:26px}
.critter.pig .body{position:absolute;bottom:6px;left:2px;width:34px;height:16px;background:#f2a8bc;border:3px solid #c46e84;border-radius:8px}
.critter.pig .head{position:absolute;bottom:7px;left:29px;width:15px;height:14px;background:#f4b3c5;border:3px solid #c46e84;border-radius:5px}
.critter.pig .snout{position:absolute;bottom:11px;left:41px;width:6px;height:6px;background:#e58aa2;border:2px solid #c46e84}
.critter.pig .ear{position:absolute;bottom:19px;left:31px;width:6px;height:6px;background:#e58aa2;clip-path:polygon(0 0,100% 0,50% 100%)}
.critter.pig .eye{position:absolute;bottom:15px;left:35px;width:3px;height:3px;background:#3a2530}
.critter.pig .tail{position:absolute;bottom:13px;left:-3px;width:7px;height:8px;border:2px solid #c46e84;border-radius:50%;border-left-color:transparent;border-bottom-color:transparent}
.critter.pig .leg{position:absolute;bottom:0;width:6px;height:7px;background:#e79cb0}
.critter.pig .l1{left:5px;animation:stepA .5s linear infinite}
.critter.pig .l2{left:25px;animation:stepB .5s linear infinite}

/* Huhn */
.critter.chicken{width:28px;height:32px;bottom:96px}
.critter.chicken .body{position:absolute;bottom:8px;left:2px;width:20px;height:16px;background:#f4f4f0;border:3px solid #cfae4d;border-radius:8px 10px 8px 8px}
.critter.chicken .head{position:absolute;bottom:16px;left:12px;width:12px;height:12px;background:#f8f8f4;border:3px solid #cfae4d;border-radius:5px}
.critter.chicken .comb{position:absolute;bottom:26px;left:14px;width:8px;height:5px;background:#e0483c;border:2px solid #a5322a}
.critter.chicken .beak{position:absolute;bottom:19px;left:23px;width:5px;height:4px;background:#f0a12b;border:1px solid #b9731a}
.critter.chicken .wattle{position:absolute;bottom:15px;left:20px;width:3px;height:5px;background:#e0483c}
.critter.chicken .eye{position:absolute;bottom:22px;left:17px;width:3px;height:3px;background:#231c14}
.critter.chicken .tail{position:absolute;bottom:14px;left:-4px;width:9px;height:12px;background:#e9e9e4;border:3px solid #cfae4d;clip-path:polygon(100% 0,100% 100%,0 60%)}
.critter.chicken .leg{position:absolute;bottom:0;width:3px;height:8px;background:#f0a12b}
.critter.chicken .l1{left:7px;animation:stepA .34s linear infinite}
.critter.chicken .l2{left:14px;animation:stepB .34s linear infinite}

/* Fledermaus (Höhle) */
.critter.bat{width:34px;height:16px;top:24%;bottom:auto}
.scene.cave .critter.bat{display:block;animation:batFly 12s linear infinite}
@keyframes batFly{from{left:-14%}to{left:114%}}
.critter.bat .body{position:absolute;left:13px;top:4px;width:8px;height:9px;background:#2a2233;border:2px solid #120d18;border-radius:3px}
.critter.bat .eye{position:absolute;left:15px;top:6px;width:3px;height:3px;background:#ff6}
.critter.bat .wing{position:absolute;top:2px;width:12px;height:10px;background:#3a2f47;border:2px solid #120d18;clip-path:polygon(0 40%,50% 0,100% 40%,80% 100%,20% 100%)}
.critter.bat .wl{left:0;animation:flap .28s ease-in-out infinite}
.critter.bat .wr{right:0;animation:flap .28s ease-in-out infinite reverse}
@keyframes flap{0%,100%{transform:scaleY(1)}50%{transform:scaleY(.42)}}

/* UFO (Weltraum) */
.critter.ufo{width:52px;height:40px;top:24%;bottom:auto}
.scene.space .critter.ufo{display:block;animation:ufoFly 20s linear infinite}
@keyframes ufoFly{from{left:-16%}to{left:116%}}
.critter.ufo .dome{position:absolute;left:16px;top:0;width:20px;height:14px;background:radial-gradient(circle at 40% 30%,#bff6ff,#5ad0ff);border:2px solid #2f7f99;border-radius:12px 12px 0 0}
.critter.ufo .disc{position:absolute;left:0;top:11px;width:52px;height:12px;background:linear-gradient(#cfd6db,#8b959c);border:2px solid #2b3a44;border-radius:50%}
.critter.ufo .beam{position:absolute;left:16px;top:20px;width:20px;height:20px;background:linear-gradient(180deg,rgba(128,231,255,.5),transparent);clip-path:polygon(20% 0,80% 0,100% 100%,0 100%);animation:beamPulse 1.6s ease-in-out infinite}
@keyframes beamPulse{0%,100%{opacity:.35}50%{opacity:.8}}
.critter.ufo .light{position:absolute;top:15px;width:4px;height:4px;border-radius:50%;background:#ffe98a;box-shadow:0 0 5px #ffe98a}
.critter.ufo .g1{left:8px}.critter.ufo .g2{left:24px}.critter.ufo .g3{left:40px}

/* ---- DRIFTENDE WOLKEN (Parallax) ---- */
.c1{animation:cloudSway 26s ease-in-out infinite}
.c2{animation:cloudSway2 34s ease-in-out infinite}
@keyframes cloudSway{0%,100%{transform:translateX(0)}50%{transform:translateX(24px)}}
@keyframes cloudSway2{0%,100%{transform:scale(1.12) translateX(0)}50%{transform:scale(1.12) translateX(-20px)}}
.scene:not(.cave):not(.space) .vc1{animation:cloudDriftL 54s linear infinite}
.scene:not(.cave):not(.space) .vc2{animation:cloudDriftL 74s linear -30s infinite}
.scene:not(.cave):not(.space) .vc3{animation:cloudDriftL 40s linear -12s infinite}
@keyframes cloudDriftL{from{left:-16%}to{left:114%}}

/* ---- SANFTER TAG/NACHT-SCHIMMER ---- */
.daynight{position:absolute;inset:0;pointer-events:none;z-index:3;opacity:0;mix-blend-mode:multiply;background:linear-gradient(180deg,#2a4a86,#101f3d)}
.scene:not(.cave):not(.space) .daynight{animation:dayNight 60s ease-in-out infinite}
@keyframes dayNight{0%,100%{opacity:0}45%{opacity:0}66%{opacity:.32}82%{opacity:.1}}

/* ---- FACKELN FLACKERN ---- */
.block-post::after{animation:torchFlicker 1.5s ease-in-out infinite}
.tunnel::after{animation:torchFlicker 1.9s ease-in-out infinite}
@keyframes torchFlicker{0%,100%{opacity:1;filter:brightness(1)}25%{opacity:.9;filter:brightness(1.3)}55%{opacity:.85;filter:brightness(1.12)}80%{opacity:.95;filter:brightness(1.22)}}

/* ---- WASSER GLITZERT / FLIESST (Fluss) ---- */
.scene.river .waterfall{
  background:repeating-linear-gradient(180deg,#a7f1ff 0 7px,#7fe0f5 7px 13px,#4ec2ef 13px 20px);
  background-size:100% 40px;animation:waterFlow .85s linear infinite
}
@keyframes waterFlow{from{background-position:0 0}to{background-position:0 40px}}
.scene.river .waterfall::before{animation:waterSplash 1.1s ease-in-out infinite}
@keyframes waterSplash{0%,100%{transform:scaleX(1)}50%{transform:scaleX(1.12)}}

/* ---- STERNE FUNKELN + STERNSCHNUPPE (Weltraum) ---- */
.scene.space .space-stars{animation:twinkleA 3.6s ease-in-out infinite}
@keyframes twinkleA{0%,100%{opacity:1}50%{opacity:.5}}
.scene.space .space-stars::after{content:"";position:absolute;inset:0;pointer-events:none;background:
  radial-gradient(circle at 15% 40%,rgba(255,255,255,.9) 0 1.3px,transparent 1.7px),
  radial-gradient(circle at 40% 47%,rgba(255,255,255,.85) 0 1.2px,transparent 1.6px),
  radial-gradient(circle at 63% 44%,rgba(255,255,255,.9) 0 1.4px,transparent 1.8px),
  radial-gradient(circle at 83% 52%,rgba(255,255,255,.8) 0 1.2px,transparent 1.6px),
  radial-gradient(circle at 72% 38%,rgba(255,255,255,.9) 0 1.3px,transparent 1.7px),
  radial-gradient(circle at 25% 55%,rgba(255,255,255,.8) 0 1.2px,transparent 1.6px);
  animation:twinkleB 2.4s ease-in-out infinite}
@keyframes twinkleB{0%,100%{opacity:.4}50%{opacity:1}}
.shooting-star{display:none}
.scene.space .shooting-star{display:block;position:absolute;top:13%;left:0;width:70px;height:3px;background:linear-gradient(90deg,transparent,#fff);border-radius:2px;opacity:0;filter:drop-shadow(0 0 4px #bfe9ff);animation:shoot 9s ease-in 3s infinite}
@keyframes shoot{0%{opacity:0;transform:translate(-80px,0) rotate(20deg)}4%{opacity:1}14%{opacity:0;transform:translate(340px,120px) rotate(20deg)}100%{opacity:0;transform:translate(340px,120px) rotate(20deg)}}

/* ---- PLANETEN DREHEN / SCHWEBEN (Weltraum) ---- */
.scene.space .planet-orb{animation:planetBob 6s ease-in-out infinite}
@keyframes planetBob{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.scene.space .planet-orb::before{content:"";position:absolute;inset:0;border-radius:50%;pointer-events:none;background:linear-gradient(118deg,rgba(255,255,255,.16) 0 18%,transparent 42%);animation:spin 22s linear infinite}
@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}
.scene.space .planet-orb.earth::after{animation:spin 26s linear infinite}
.scene.space .planet-ring.show{animation:ringBob 6s ease-in-out infinite}
@keyframes ringBob{0%,100%{transform:rotate(-12deg) translateY(0)}50%{transform:rotate(-12deg) translateY(-6px)}}

/* ---- MEILENSTEIN-BANNER ---- */
.milestone-banner{position:absolute;left:50%;top:38%;transform:translate(-50%,-50%) scale(.6);z-index:8;padding:10px 18px;background:linear-gradient(#ffd75b,#f0a51e);color:#5a3a00;font-weight:1000;font-size:clamp(18px,3vw,26px);border:4px solid #8a5a12;border-radius:8px;box-shadow:0 6px 0 rgba(0,0,0,.3);opacity:0;pointer-events:none;text-shadow:0 2px 0 rgba(255,255,255,.4);white-space:nowrap}
.milestone-banner.show{animation:milestonePop 2.1s ease}
@keyframes milestonePop{0%{opacity:0;transform:translate(-50%,-50%) scale(.5)}15%{opacity:1;transform:translate(-50%,-50%) scale(1.12)}28%{transform:translate(-50%,-50%) scale(1)}80%{opacity:1}100%{opacity:0;transform:translate(-50%,-64%) scale(1)}}

/* ---- SCHATZKISTE (Level-Ende) ---- */
.chest{position:relative;width:84px;height:66px;margin:0 auto}
.chest .glow{position:absolute;left:50%;top:50%;width:120px;height:120px;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgba(255,231,120,.75),transparent 62%);opacity:0;transition:opacity .5s;z-index:0}
.chest.open .glow{opacity:1;animation:chestGlow 1.4s ease-out}
@keyframes chestGlow{0%{opacity:0;transform:translate(-50%,-50%) scale(.4)}40%{opacity:1}100%{opacity:.55;transform:translate(-50%,-50%) scale(1.15)}}
.chest .box{position:absolute;bottom:0;left:8px;width:68px;height:38px;background:#8a5a2b;border:4px solid #4a2e15;border-radius:0 0 5px 5px;z-index:2;box-shadow:inset 0 4px 0 rgba(255,255,255,.08)}
.chest .box::before{content:"";position:absolute;left:0;right:0;top:12px;height:6px;background:#6a4320}
.chest .box::after{content:"";position:absolute;left:50%;top:9px;transform:translateX(-50%);width:14px;height:18px;background:#f3c94c;border:3px solid #7a5715;z-index:3}
.chest .lid{position:absolute;top:0;left:6px;width:72px;height:24px;background:#9a6631;border:4px solid #4a2e15;border-radius:6px 6px 0 0;transform-origin:0% 100%;transition:transform .55s cubic-bezier(.2,1.3,.4,1);z-index:4}
.chest.open .lid{transform:rotate(-46deg)}
.chest .loot{position:absolute;left:50%;top:14px;transform:translate(-50%,8px) scale(.4);opacity:0;transition:transform .5s .18s cubic-bezier(.2,1.4,.4,1),opacity .4s .18s;z-index:5}
.chest.open .loot{transform:translate(-50%,-18px) scale(1);opacity:1}

/* ---- Bewegung sparsam bei „reduzierte Bewegung" ---- */
@media (prefers-reduced-motion: reduce){
  .critter,.voxel-cloud,.cloud,.daynight,.shooting-star,.space-stars,
  .planet-orb,.planet-ring.show,.block-post::after,.tunnel::after,
  .scene.river .waterfall,.rail-spark,
  #cartWrap .pet,#cartWrap .pet .tail,#cartWrap .pet .leg,.deco.bird,.deco.bird .wing,.deco.bee,.deco.bee .wing1,.deco.bee .wing2,.deco.frog,.deco.butterfly,.deco.butterfly .wing1,.deco.butterfly .wing2,.deco.butterfly .wing3,.deco.butterfly .wing4,.deco.cloud{animation:none !important}
  .daynight{opacity:0 !important}
}


