const SAVE_KEY="minecart_final_v66";
const LEGACY_KEYS=[SAVE_KEY,"minecart_boss_v65","minecart_boss_v64","minecart_longtrack_v63","minecart_tunnel_v62","minecart_loop_gold_v54","minecart_deco_camera_v52","minecart_plusminus_v5","minecart_weltraum_v4","minecart_builder_bg_v38","minecart_artpass_v37","minecart_polish_state_v36","minecart_polish_state"];

function loadState(){
  for(const key of LEGACY_KEYS){
    try{
      const raw=localStorage.getItem(key);
      if(!raw) continue;
      const data=JSON.parse(raw);
      if(data && typeof data==="object"){
        let loadedLevel=Number.isInteger(data.levelIndex)?data.levelIndex:0;

        // In v4 begann das 1×1 schon bei Levelindex 3.
        // In v5 liegen jetzt fünf neue Plus-/Minus-Welten davor.
        if(key==="minecart_weltraum_v4" && loadedLevel>=3){
          loadedLevel+=5;
        }

        // v6.4 (boss_v64) hat bereits die neue Level-Struktur -> nicht umrechnen.
        if(![SAVE_KEY,"minecart_boss_v65","minecart_boss_v64"].includes(key)){ loadedLevel = oldWorldToLevelIndex(loadedLevel); }
        state.levelIndex=loadedLevel;
        state.levelScore=Number.isInteger(data.levelScore)?data.levelScore:0;
        state.totalStars=Number.isInteger(data.totalStars)?data.totalStars:0;
        state.currentTask=null;
        state.items={...state.items,...(data.items||{})};
        if(!data.items || !Number.isFinite(data.items.gold)){
          // Existing players receive some gold for stars they already earned.
          state.items.gold=Math.floor(state.totalStars/20);
        }
        if(Array.isArray(data.build)){
          state.build=Array.from({length:BUILD_SLOT_COUNT},(_,i)=>data.build[i]??null);
        }
        state.buildThemeIndex=Number.isInteger(data.buildThemeIndex)?data.buildThemeIndex:0;
        state.decorations={...state.decorations,...(data.decorations||{})};
        if(Array.isArray(data.placedDecos)){
          state.placedDecos=Array.from({length:BUILD_SLOT_COUNT},(_,i)=>data.placedDecos[i]??null);
        }
        break;
      }
    }catch(e){}
  }
  migrateBuildV66();
  if(state.buildThemeIndex>=BUILD_THEMES.length) state.buildThemeIndex=0;
  if(state.levelIndex<0 || state.levelIndex>=CONFIG.levels.length) state.levelIndex=0;
}

function migrateBuildV66(){
  const old=Array.isArray(state.build)?state.build.slice():[];
  const oldDecos=Array.isArray(state.placedDecos)?state.placedDecos.slice():[];
  const count=old.findIndex(v=>!v);
  const used=count===-1?old.length:count;
  const oldJumpCount=old.slice(0,used).filter(v=>v==="jump").length;
  if(!oldJumpCount)return;

  if(used+oldJumpCount*2<=BUILD_SLOT_COUNT){
    const b=[],d=[];
    for(let i=0;i<used;i++){
      if(old[i]==="jump"){
        b.push("jump-start","jump-gap","jump-land");
        d.push(oldDecos[i]||null,null,null);
      }else{
        b.push(old[i]);
        d.push(oldDecos[i]||null);
      }
    }
    while(b.length<BUILD_SLOT_COUNT)b.push(null);
    while(d.length<BUILD_SLOT_COUNT)d.push(null);
    state.build=b.slice(0,BUILD_SLOT_COUNT);
    state.placedDecos=d.slice(0,BUILD_SLOT_COUNT);
  }else{
    state.build=old.map(v=>v==="jump"?"jump-legacy":v);
  }
}

function save(){
  try{localStorage.setItem(SAVE_KEY,JSON.stringify(state))}catch(e){}
}

function currentLevel(){return CONFIG.levels[state.levelIndex]}
function unlockedBuildThemes(){
  return BUILD_THEMES.filter(t=>state.totalStars>=t.unlock);
}
function ensureValidBuildTheme(){
  const unlocked=unlockedBuildThemes();
  const idx=unlocked.findIndex((t,i)=>i===state.buildThemeIndex);
  if(state.buildThemeIndex>unlocked.length-1) state.buildThemeIndex=unlocked.length-1;
  if(state.buildThemeIndex<0) state.buildThemeIndex=0;
}
function applyBuildTheme(){
  ensureValidBuildTheme();
  const area=$("buildArea");
  if(!area) return;
  area.className="build-area "+BUILD_THEMES[state.buildThemeIndex].className;
}
function renderBuildThemePicker(){
  const holder=$("buildThemePicker");
  if(!holder) return;
  holder.innerHTML="";
  BUILD_THEMES.forEach((theme,idx)=>{
    const unlocked=state.totalStars>=theme.unlock;
    const btn=document.createElement("button");
    btn.className=`theme-btn${unlocked?"":" locked"}${state.buildThemeIndex===idx?" active":""}`;
    btn.disabled=!unlocked;
    btn.innerHTML=`${theme.name}<small>${unlocked?"auswählen":`frei ab ${theme.unlock} ⭐`}</small>`;
    btn.onclick=()=>{
      if(!unlocked) return;
      state.buildThemeIndex=idx;
      applyBuildTheme();
      renderBuildThemePicker();
      save();
      buildStatus(`Bau-Hintergrund gewählt: ${theme.name}.`);
    };
    holder.appendChild(btn);
  });
}

