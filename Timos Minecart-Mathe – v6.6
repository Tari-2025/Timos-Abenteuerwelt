<script>
const CONFIG={
  playerName:"Timo",
  tasksPerLevel:5,
  levels:[]
};

/* ---- Welten (ohne Bosse) ---- */
const WORLDS=[
  {title:"Grüner Wald",pack:"plus10",theme:"forest",icon:"i-forest"},
  {title:"Bergwerk",pack:"plus20",theme:"mountain",icon:"i-mountain"},
  {title:"Diamanthöhle",pack:"minus20",theme:"cave",icon:"i-cave"},
  {title:"Flusswiese",subtitle:"Plus & Minus bis 20",pack:"mix20",theme:"river",chip:"\u00b120",chipColor:"#72dcff"},
  {title:"Herbstwald",subtitle:"Plus & Minus bis 30",pack:"mix30easy",theme:"autumnmath",chip:"\u00b130",chipColor:"#f0a04a"},
  {title:"Schneetal",subtitle:"Plus & Minus bis 40",pack:"mix40easy",theme:"snowmath",chip:"\u00b140",chipColor:"#dff8ff"},
  {title:"Regenbogenberge",subtitle:"Plus & Minus bis 50",pack:"mix50easy",theme:"rainbowmath",chip:"\u00b150",chipColor:"#ffd85a"},
  {title:"Goldene Stadt",subtitle:"Zehner bis 100",pack:"tens100",theme:"goldcity",chip:"100",chipColor:"#ffd65b"},
  {title:"R\u00e4tselh\u00f6hle",subtitle:"L\u00fcckenaufgaben",pack:"gapMix",theme:"cave",chip:"?",chipColor:"#b98cff"},
  {title:"Dorf am Fluss",subtitle:"Textaufgaben",pack:"wordMix",theme:"river",chip:"ABC",chipColor:"#8fe36b"},
  {title:"Mond",subtitle:"1er-Reihe",pack:"times1",theme:"space",spaceBody:"moon",chip:"1\u00d7",chipColor:"#dfe7ee"},
  {title:"Merkur",subtitle:"2er-Reihe",pack:"times2",theme:"space",spaceBody:"mercury",chip:"2\u00d7",chipColor:"#d7a06a"},
  {title:"Venus",subtitle:"3er-Reihe",pack:"times3",theme:"space",spaceBody:"venus",chip:"3\u00d7",chipColor:"#e5a86b"},
  {title:"Erde",subtitle:"4er-Reihe",pack:"times4",theme:"space",spaceBody:"earth",chip:"4\u00d7",chipColor:"#5ecaff"},
  {title:"Mars",subtitle:"5er-Reihe",pack:"times5",theme:"space",spaceBody:"mars",chip:"5\u00d7",chipColor:"#e57848"},
  {title:"Jupiter",subtitle:"6er-Reihe",pack:"times6",theme:"space",spaceBody:"jupiter",chip:"6\u00d7",chipColor:"#d8b07a"},
  {title:"Saturn",subtitle:"7er-Reihe",pack:"times7",theme:"space",spaceBody:"saturn",chip:"7\u00d7",chipColor:"#d2bc8b"},
  {title:"Uranus",subtitle:"8er-Reihe",pack:"times8",theme:"space",spaceBody:"uranus",chip:"8\u00d7",chipColor:"#8eeef3"},
  {title:"Neptun",subtitle:"9er-Reihe",pack:"times9",theme:"space",spaceBody:"neptune",chip:"9\u00d7",chipColor:"#5a97f0"},
  {title:"Sonne",subtitle:"10er-Reihe",pack:"times10",theme:"space",spaceBody:"sun",chip:"10\u00d7",chipColor:"#ffcb59"}
];

/* ---- Bosse ---- */
const BOSS_META={
  creeper :{title:"Creeper-\u00dcberfall",  chip:"\u2620", chipColor:"#7ed36b"},
  zombie  :{title:"Zombie-Nacht",       chip:"\u2620", chipColor:"#6ab04c"},
  skeleton:{title:"Skelett-Sch\u00fctzen",  chip:"\u2620", chipColor:"#e8ecef"},
  spider  :{title:"H\u00f6hlenspinne",      chip:"\u2620", chipColor:"#b0453a"},
  dragon  :{title:"Der Enderdrache",    chip:"\ud83d\udc09", chipColor:"#a06cff"}
};
function makeBoss(enemy,tier){
  const m=BOSS_META[enemy];
  return {boss:true,enemy,title:m.title,subtitle:"Boss-Kampf",theme:"boss",pack:tier,chip:m.chip,chipColor:m.chipColor};
}
const ENEMY_CYCLE=["creeper","zombie","skeleton","spider","creeper","zombie"];
const BOSS_TIERS =["bossEasy","bossEasy","bossMid","bossMid","bossHard","bossHard"];
const worldToLevel=[];
(function buildLevels(){
  const L=[]; let bossN=0;
  WORLDS.forEach((w,i)=>{
    worldToLevel[i]=L.length;
    L.push(w);
    if((i+1)%3===0){
      L.push(makeBoss(ENEMY_CYCLE[bossN%ENEMY_CYCLE.length], BOSS_TIERS[Math.min(bossN,BOSS_TIERS.length-1)]));
      bossN++;
    }
  });
  L.push(makeBoss("dragon","bossHard"));  // gro\u00dfes Finale
  CONFIG.levels=L;
})();
/* Alt-Spielst\u00e4nde z\u00e4hlten nur Welten (ohne Bosse, ohne die 2 neuen Welten). */
function oldWorldToLevelIndex(old){
  let w = old<=7 ? old : old+2;          // 2 neue Welten nach der Goldenen Stadt
  if(w<0) w=0;
  if(w>=worldToLevel.length) w=worldToLevel.length-1;
  return worldToLevel[w];
}

function rand(min,max){return Math.floor(Math.random()*(max-min+1))+min}
function timesPack(n){
  return {label:`${n}er-Reihe`, task(){const b=rand(1,10); return {text:`${b} × ${n} = ?`, answer:b*n}}}
}
function easyMix(max,smallMax=10){
  const plus=Math.random()<.5;
  if(plus){
    const b=rand(1,smallMax);
    const a=rand(0,Math.max(0,max-b));
    return {text:`${a} + ${b} = ?`,answer:a+b};
  }else{
    const b=rand(1,smallMax);
    const a=rand(b,max);
    return {text:`${a} − ${b} = ?`,answer:a-b};
  }
}
const PACKS={
  plus10:{label:"Plus bis 10",task(){const r=rand(2,10),a=rand(1,r-1);return{text:`${a} + ${r-a} = ?`,answer:r}}},
  plus20:{label:"Plus bis 20",task(){const r=rand(3,20),a=rand(1,r-1);return{text:`${a} + ${r-a} = ?`,answer:r}}},
  minus20:{label:"Minus bis 20",task(){const a=rand(2,20),b=rand(1,a);return{text:`${a} − ${b} = ?`,answer:a-b}}},

  mix20:{label:"Plus & Minus bis 20",task(){return easyMix(20,8)}},
  mix30easy:{label:"Plus & Minus bis 30",task(){return easyMix(30,9)}},
  mix40easy:{label:"Plus & Minus bis 40",task(){return easyMix(40,10)}},
  mix50easy:{label:"Plus & Minus bis 50",task(){return easyMix(50,10)}},
  tens100:{
    label:"Zehner bis 100",
    task(){
      const plus=Math.random()<.5;
      if(plus){
        const a=rand(1,8)*10;
        const b=rand(1,10-a/10)*10;
        return {text:`${a} + ${b} = ?`,answer:a+b};
      }else{
        const a=rand(2,10)*10;
        const b=rand(1,a/10)*10;
        return {text:`${a} − ${b} = ?`,answer:a-b};
      }
    }
  },

  times1:timesPack(1), times2:timesPack(2), times3:timesPack(3), times4:timesPack(4), times5:timesPack(5),
  times6:timesPack(6), times7:timesPack(7), times8:timesPack(8), times9:timesPack(9), times10:timesPack(10)
};

/* ===================================================================== */
/* ==========  v6.4 – LÜCKEN/TEXT-AUFGABEN + BOSS-LOGIK  ============== */
/* ===================================================================== */

/* ---- Lückenaufgaben ---- */
function gapFrom(text, answer){
  return {text, html:text.replace("?", '<span class="blank">?</span>'), answer, kind:"gap"};
}
function gapMixTask(max, allowTimes){
  const roll=Math.random();
  if(allowTimes && roll<.34){
    const n=rand(2,10), q=rand(2,10), p=n*q;
    return Math.random()<.5 ? gapFrom(`? × ${n} = ${p}`, q) : gapFrom(`${n} × ? = ${p}`, q);
  }
  if(roll<.67){
    if(Math.random()<.5){ const a=rand(1,max-1), ans=rand(1,max-a); return gapFrom(`${a} + ? = ${a+ans}`, ans); }
    const b=rand(1,max-1), ans=rand(1,max-b); return gapFrom(`? + ${b} = ${ans+b}`, ans);
  }
  if(Math.random()<.5){ const a=rand(2,max), ans=rand(1,a); return gapFrom(`${a} − ? = ${a-ans}`, ans); }
  const b=rand(1,max-1), c=rand(1,max-b), ans=b+c; return gapFrom(`? − ${b} = ${c}`, ans);
}

