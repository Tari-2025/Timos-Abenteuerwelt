  window.addEventListener("resize",applyManualCamera);

  const arm=()=>{Sound.init();window.removeEventListener("pointerdown",arm);window.removeEventListener("keydown",arm)};
  window.addEventListener("pointerdown",arm);window.addEventListener("keydown",arm)
});
</script>
</body>
