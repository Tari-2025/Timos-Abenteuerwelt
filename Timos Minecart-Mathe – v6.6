<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
<title>Timos Minecart-Mathe – v6.6 Abschlussfahrt</title>
<style>
:root{
  --gold:#f6c84d;
  --gold2:#d89d23;
  --ink:#0d1110;
  --frame:#5b655e;
  --frame-hi:#8b978d;
  --panel:#1a201b;
  --panel2:#272e28;
  --panel3:#343c35;
  --cream:#fff0c5;
  --green:#6fd244;
  --green2:#3d9920;
  --danger:#e76b61;
  --muted:#c9d1cb;
  --slot:#303730;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Arial Black,Impact,Arial,Helvetica,sans-serif;image-rendering:pixelated}
body{color:white;overflow-x:hidden;background:#4f9341}
button,input{font:inherit}
button{touch-action:manipulation}

/* ---------- THEME VARIABLES ---------- */
body.theme-forest{
  --sky:#6dcfff; --sky2:#bdefff; --ground:#79c94e; --ground2:#4f9b38; --earth:#7d522f;
  --scene-dark:#2f7a30; --accent:#79d84b; --glow:rgba(153,255,116,.28);
}
body.theme-mountain{
  --sky:#8ccde9; --sky2:#e5f3f8; --ground:#99a563; --ground2:#727b4e; --earth:#685a4a;
  --scene-dark:#626760; --accent:#d2b06d; --glow:rgba(255,226,165,.22);
}
body.theme-cave{
  --sky:#242b35; --sky2:#3b4657; --ground:#49525c; --ground2:#313a44; --earth:#342e34;
  --scene-dark:#1d2730; --accent:#65e7ff; --glow:rgba(101,231,255,.25);
}
body.theme-space{
  --sky:#111826; --sky2:#1d2940; --ground:#1b2431; --ground2:#101722; --earth:#0e131c;
  --scene-dark:#0d1420; --accent:#80e7ff; --glow:rgba(128,231,255,.25);
}
body.theme-river{
  --sky:#79d7ff; --sky2:#d8f5ff; --ground:#79ca63; --ground2:#4b9f58; --earth:#76563c;
  --scene-dark:#2e7c72; --accent:#72dcff; --glow:rgba(114,220,255,.24);
}
body.theme-autumnmath{
  --sky:#9fd8ef; --sky2:#f3e3c4; --ground:#c98a3f; --ground2:#925d32; --earth:#66442f;
  --scene-dark:#7b4d2a; --accent:#f0b04b; --glow:rgba(240,176,75,.24);
}
body.theme-snowmath{
  --sky:#b9e8ff; --sky2:#f3fbff; --ground:#eaf8ff; --ground2:#b8dce8; --earth:#8ea7b4;
  --scene-dark:#7699aa; --accent:#dff8ff; --glow:rgba(223,248,255,.34);
}
body.theme-rainbowmath{
  --sky:#82d9ff; --sky2:#e7f8ff; --ground:#86cf69; --ground2:#5aa84e; --earth:#775239;
  --scene-dark:#6d77b8; --accent:#ffd85a; --glow:rgba(255,216,90,.28);
}
body.theme-goldcity{
  --sky:#f3c66e; --sky2:#fff1bd; --ground:#cfa657; --ground2:#9b743c; --earth:#6d4e2b;
  --scene-dark:#815f2d; --accent:#ffd65b; --glow:rgba(255,214,91,.34);
}

/* ---------- INLINE ICON SYSTEM ---------- */
.icon-svg{
  width:1em;height:1em;display:inline-block;vertical-align:-.16em;
  filter:drop-shadow(0 2px 0 rgba(0,0,0,.28));
}
.icon-sm{width:22px;height:22px}
.icon-md{width:30px;height:30px}
.icon-lg{width:42px;height:42px}
.icon-xl{width:58px;height:58px}

/* ---------- BACKGROUND ---------- */
.world-bg{
  position:fixed;inset:0;z-index:-5;
  background:
    linear-gradient(180deg,var(--sky) 0 39%, var(--ground) 39% 62%, var(--earth) 62% 100%);
  transition:background .45s ease;
}
.world-bg::after{
  content:"";position:absolute;inset:0;opacity:.16;
  background:
    linear-gradient(90deg,rgba(255,255,255,.18) 1px,transparent 1px) 0 0/36px 36px,
    linear-gradient(rgba(255,255,255,.12) 1px,transparent 1px) 0 0/36px 36px;
}
.cloud{
  position:absolute;width:90px;height:28px;background:#fff;
  box-shadow:30px 0 #fff,60px 0 #fff,30px -18px #fff;opacity:.93;z-index:-4
}
.c1{left:6%;top:7%}.c2{right:9%;top:12%;transform:scale(1.12)}
body.theme-cave .cloud, body.theme-space .cloud{display:none}
.hill{
  position:absolute;bottom:35%;width:30vw;min-width:180px;max-width:350px;height:18vw;min-height:105px;
  background:var(--ground2);clip-path:polygon(0 100%,15% 56%,31% 72%,49% 25%,68% 66%,100% 100%);
  z-index:-4;filter:brightness(.9)
}
.h1{left:-3%}.h2{right:-3%;transform:scaleX(-1)}
body.theme-cave .hill, body.theme-space .hill{display:none}

/* ---------- APP SHELL ---------- */
.app{width:min(1180px,100%);margin:0 auto;padding:10px}
.brand{
  position:relative;
  display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;
  margin:6px auto 14px;width:min(900px,96%);padding:12px 18px 15px;
  background:
    linear-gradient(90deg,rgba(255,255,255,.08) 0 2px,transparent 2px 34px) 0 0/36px 36px,
    linear-gradient(rgba(255,255,255,.05) 0 2px,transparent 2px 34px) 0 0/36px 36px,
    linear-gradient(#557050 0 22%,#3f5b3b 22% 29%,#735033 29% 100%);
  border:6px solid #2b342b;border-radius:4px;
  box-shadow:inset 0 5px 0 rgba(255,255,255,.10),inset 0 -7px 0 rgba(0,0,0,.22),0 7px 0 #151a15,0 14px 24px rgba(0,0,0,.35)
}
.brand::before,.brand::after{
  content:"";position:absolute;bottom:-8px;width:38px;height:20px;
  background:#6f4d31;border:4px solid #3f2b1d;z-index:-1
}
.brand::before{left:12%}.brand::after{right:12%}
.brand-title{
  display:flex;gap:9px;flex-wrap:wrap;justify-content:center;
  font-weight:1000;font-size:clamp(30px,5vw,64px);line-height:.9;
  letter-spacing:-1px;text-transform:uppercase;
  filter:drop-shadow(0 5px 0 rgba(0,0,0,.34))
}
.brand-title .player{
  color:#ffd45b;
  text-shadow:3px 0 #704d12,-3px 0 #704d12,0 3px #704d12,0 -3px #704d12,5px 5px 0 #30220d
}
.brand-title .game{
  color:#83e35a;
  text-shadow:3px 0 #23551e,-3px 0 #23551e,0 3px #23551e,0 -3px #23551e,5px 5px 0 #142b12
}
body.theme-cave .brand-title .game{color:#82efff}
.brand-icon{
  width:54px;height:54px;display:grid;place-items:center;
  background:linear-gradient(135deg,rgba(255,255,255,.10) 0 14%,transparent 14%),linear-gradient(#59635b,#303831);
  border:5px solid #747e75;border-radius:3px;
  box-shadow:inset 0 0 0 3px #1d231e,inset 0 5px 0 rgba(255,255,255,.08),0 5px 0 #111511
}

/* ---------- GAME WINDOW ---------- */
.game-window{
  position:relative;
  background:
    linear-gradient(90deg,rgba(255,255,255,.025) 1px,transparent 1px) 0 0/28px 28px,
    linear-gradient(#202720,#161b17);
  border:8px solid var(--frame);outline:4px solid #090b09;border-radius:5px;
  overflow:hidden;box-shadow:inset 0 0 0 3px rgba(255,255,255,.04),0 9px 0 #0c100d,0 19px 38px rgba(0,0,0,.48)
}
.topbar{
  display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;
  padding:12px 14px;
  background:
    linear-gradient(90deg,rgba(255,255,255,.035) 0 2px,transparent 2px 30px) 0 0/32px 32px,
    linear-gradient(#364039,#222a24);
  border-bottom:6px solid #0a0d0a;box-shadow:inset 0 -3px 0 rgba(255,255,255,.035)
}
.level-title{display:flex;align-items:center;gap:8px;font-size:clamp(18px,2.5vw,29px);font-weight:1000}
.level-chip{
  width:34px;height:34px;display:grid;place-items:center;border-radius:8px;
  background:#1a1f1b;border:3px solid #505950
}
.top-right{display:flex;align-items:center;gap:8px}
.progress{
  padding:7px 12px;border-radius:10px;background:#141714;border:3px solid #485248;
  color:var(--gold);font-size:clamp(16px,2.1vw,24px);font-weight:1000;white-space:nowrap
}
.soundbtn{
  width:48px;height:44px;border-radius:10px;background:linear-gradient(#454e46,#2a302b);
  border:3px solid #59635a;color:#fff;cursor:pointer;
  box-shadow:inset 0 0 0 2px #111512,0 3px 0 #0a0c0a
}
.soundbtn.off{opacity:.58}

/* ---------- MAIN LAYOUT ---------- */
.main-grid{
  display:grid;grid-template-columns:64px minmax(0,1.18fr) minmax(290px,.82fr);
  gap:12px;padding:12px
}
.sidebar{display:flex;flex-direction:column;gap:9px}
.sidebtn,.trophybtn{
  border:3px solid #566057;border-radius:10px;background:linear-gradient(#424a43,#282e29);
  box-shadow:inset 0 0 0 2px #111512,0 3px 0 #090b09;color:#fff;cursor:pointer
}
.sidebtn{width:56px;height:56px;display:grid;place-items:center}
.sidebtn:hover,.trophybtn:hover,.soundbtn:hover,.primary:hover,.build-btn:hover{filter:brightness(1.08)}

/* ---------- SCENE ---------- */
.scene{
  position:relative;min-height:338px;overflow:hidden;
  border:5px solid #0d100d;border-radius:4px;box-shadow:inset 0 0 0 3px #495149,0 5px 0 #080a08
}
.scene::after{
  content:"";position:absolute;inset:0;pointer-events:none;opacity:.12;
  background:
    linear-gradient(90deg,rgba(255,255,255,.15) 1px,transparent 1px) 0 0/28px 28px,
    linear-gradient(rgba(255,255,255,.09) 1px,transparent 1px) 0 0/28px 28px
}
.scene.forest{
  background:
    radial-gradient(circle at 83% 14%,rgba(255,255,255,.35) 0 7%,transparent 7.5%),
    linear-gradient(var(--sky2) 0 31%,#93df62 31% 38%,var(--ground) 38% 68%,var(--earth) 68%)
}
.scene.mountain{
  background:
    radial-gradient(circle at 82% 15%,rgba(255,255,255,.34) 0 7%,transparent 7.5%),
    linear-gradient(#e0f3fa 0 26%,#b0bd7d 26% 34%,#8c9087 34% 67%,#655849 67%)
}
.scene.cave{
  background:
    radial-gradient(circle at 48% 9%,rgba(102,235,255,.16) 0 10%,transparent 10.5%),
    linear-gradient(#2b3440 0 16%,#3a4656 16% 33%,#39434e 33% 69%,#332e35 69%)
}
.scene.river{
  background:
    radial-gradient(circle at 84% 14%,rgba(255,255,255,.55) 0 6%,transparent 6.5%),
    linear-gradient(180deg,#d8f5ff 0 31%,#9bdf72 31% 47%,#56b9dd 47% 59%,#3d9dcc 59% 66%,#73bd58 66% 73%,#73533c 73%);
}
.scene.autumnmath{
  background:
    radial-gradient(circle at 84% 15%,rgba(255,235,169,.65) 0 7%,transparent 7.5%),
    linear-gradient(180deg,#cdeaf5 0 30%,#e5b864 30% 39%,#bd7440 39% 68%,#6b4934 68%);
}
.scene.snowmath{
  background:
    radial-gradient(circle at 84% 13%,rgba(255,255,255,.9) 0 7%,transparent 7.5%),
    linear-gradient(180deg,#eaf9ff 0 28%,#c9e8f5 28% 36%,#f4fbff 36% 69%,#a8bdc8 69%);
}
.scene.rainbowmath{
  background:
    radial-gradient(ellipse at 52% 72%,transparent 0 37%,rgba(231,79,73,.55) 37% 41%,rgba(245,152,60,.55) 41% 45%,rgba(247,213,79,.55) 45% 49%,rgba(102,194,92,.55) 49% 53%,rgba(82,159,224,.55) 53% 57%,rgba(125,102,203,.5) 57% 61%,transparent 61%),
    linear-gradient(180deg,#dff7ff 0 36%,#89d36d 36% 68%,#76523a 68%);
}
.scene.goldcity{
  background:
    radial-gradient(circle at 83% 14%,rgba(255,241,167,.78) 0 8%,transparent 8.5%),
    linear-gradient(180deg,#ffedb3 0 28%,#dfbc69 28% 36%,#b98842 36% 68%,#70502f 68%);
}

/* extra visual flavor for the five arithmetic worlds */
.scene.autumnmath .tree{display:block}
.scene.autumnmath .tree::before,.scene.autumnmath .tree::after,.scene.autumnmath .tree i{background:#d76a32}
.scene.autumnmath .tree::before{box-shadow:23px -20px #e79a3a}
.scene.snowmath .rock{display:block;background:#e9f7ff;border-color:#a5bdc8}
.scene.rainbowmath .rock{display:block;background:#7d9a76;border-color:#557052}
.scene.goldcity .support{display:block;background:#c8953f;border-color:#73501f}
.scene.goldcity .support::before{background:#e0b454;border-color:#73501f}
.scene.space{
  background:
    radial-gradient(circle at 20% 18%, rgba(255,255,255,.18) 0 2px, transparent 2.5px),
    radial-gradient(circle at 28% 31%, rgba(255,255,255,.12) 0 1.8px, transparent 2.3px),
    radial-gradient(circle at 71% 20%, rgba(255,255,255,.16) 0 2px, transparent 2.6px),
    radial-gradient(circle at 78% 41%, rgba(255,255,255,.11) 0 2px, transparent 2.4px),
    radial-gradient(circle at 55% 10%, rgba(255,255,255,.14) 0 2px, transparent 2.5px),
    linear-gradient(#121a28 0 20%, #1f2b44 20% 54%, #172131 54% 100%);
}
.space-stars,.planet-orb,.planet-ring,.planet-caption,.planet-small{display:none}
.scene.space .space-stars,.scene.space .planet-orb,.scene.space .planet-caption{display:block}
.scene.space .planet-small.show{display:block}
.scene.space .planet-ring.show{display:block}
.space-stars{position:absolute; inset:0; opacity:1; pointer-events:none; background:
  radial-gradient(circle at 10% 16%, rgba(255,255,255,.95) 0 1.2px, transparent 1.6px),
  radial-gradient(circle at 18% 28%, rgba(255,255,255,.9) 0 1.3px, transparent 1.7px),
  radial-gradient(circle at 27% 12%, rgba(255,255,255,.8) 0 1.1px, transparent 1.5px),
  radial-gradient(circle at 33% 36%, rgba(255,255,255,.95) 0 1.4px, transparent 1.8px),
  radial-gradient(circle at 46% 19%, rgba(255,255,255,.85) 0 1.1px, transparent 1.5px),
  radial-gradient(circle at 59% 9%, rgba(255,255,255,.95) 0 1.5px, transparent 1.9px),
  radial-gradient(circle at 68% 27%, rgba(255,255,255,.82) 0 1.2px, transparent 1.6px),
  radial-gradient(circle at 77% 14%, rgba(255,255,255,.95) 0 1.4px, transparent 1.8px),
  radial-gradient(circle at 87% 30%, rgba(255,255,255,.85) 0 1.2px, transparent 1.7px),
  radial-gradient(circle at 91% 18%, rgba(255,255,255,.95) 0 1.2px, transparent 1.6px);}
.planet-orb{position:absolute; right:34px; top:24px; width:110px; height:110px; border-radius:50%; box-shadow:0 0 28px rgba(255,255,255,.08)}
.planet-ring{position:absolute; right:16px; top:62px; width:150px; height:34px; border:6px solid rgba(226,215,181,.75); border-radius:50%; transform:rotate(-12deg)}
.planet-caption{position:absolute; left:16px; top:14px; padding:6px 10px; border-radius:10px; background:rgba(7,11,19,.58); border:2px solid rgba(145,174,202,.35); font-weight:900; font-size:14px; letter-spacing:.2px}
.planet-small{position:absolute; border-radius:50%; opacity:.9}
.planet-small.a{left:36px; top:54px; width:14px; height:14px; background:#bcc6cf}
.planet-small.b{left:92px; top:30px; width:10px; height:10px; background:#e4b28a}
.planet-small.c{left:132px; top:70px; width:18px; height:18px; background:#65e7ff; box-shadow:0 0 10px rgba(101,231,255,.3)}
.planet-orb.moon{background:radial-gradient(circle at 34% 28%, #f1f5f8 0 38%, #cfd9df 38% 70%, #a9b2ba 70% 100%)}
.planet-orb.mercury{background:radial-gradient(circle at 35% 30%, #f0c49b 0 38%, #d09c6e 38% 72%, #9d6a45 72% 100%)}
.planet-orb.venus{background:radial-gradient(circle at 36% 28%, #f7d3a7 0 35%, #e8a466 35% 72%, #b56f3d 72% 100%)}
.planet-orb.earth{background:radial-gradient(circle at 30% 30%, #69d5ff 0 35%, #2f9bd8 35% 70%, #1f6f9b 70% 100%)}
.planet-orb.earth::after{content:"";position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 58% 48%, transparent 0 20%, rgba(70,176,83,.95) 20% 33%, transparent 33% 100%), radial-gradient(circle at 30% 64%, transparent 0 18%, rgba(76,180,85,.95) 18% 30%, transparent 30% 100%)}
.planet-orb.mars{background:radial-gradient(circle at 34% 28%, #ffae7c 0 35%, #db7040 35% 70%, #94361f 70% 100%)}
.planet-orb.jupiter{background:repeating-linear-gradient(180deg, #f3ddb8 0 12px, #c89d67 12px 23px, #e5c18f 23px 35px, #9c6a45 35px 46px); box-shadow:0 0 30px rgba(244,214,166,.15)}
.planet-orb.saturn{background:radial-gradient(circle at 34% 28%, #efd6a0 0 38%, #c79f61 38% 72%, #8b6330 72% 100%)}
.planet-orb.uranus{background:radial-gradient(circle at 34% 30%, #c8fbff 0 40%, #81e7ef 40% 74%, #4ca7bc 74% 100%)}
.planet-orb.neptune{background:radial-gradient(circle at 34% 28%, #8fd7ff 0 38%, #447dd8 38% 74%, #20449a 74% 100%)}
.planet-orb.sun{background:radial-gradient(circle at 40% 34%, #fff5b1 0 25%, #ffd659 25% 58%, #ff9f28 58% 78%, #f06a16 78% 100%); box-shadow:0 0 36px rgba(255,179,52,.35), 0 0 70px rgba(255,130,34,.25)}

/* forest decor */
.tree{position:absolute;bottom:107px;width:32px;height:98px;background:#704729}
.tree::before,.tree::after,.tree i{content:"";position:absolute;background:#3d8e34}
.tree::before{left:-26px;top:-39px;width:86px;height:60px;box-shadow:23px -20px #4da040}
.tree::after{left:-18px;top:1px;width:70px;height:44px}
.tree i{left:-8px;top:-59px;width:50px;height:27px;background:#59b349}
.t1{left:42px}.t2{left:165px;transform:scale(.82)}.t3{right:70px;transform:scale(.9)}
.scene:not(.forest):not(.autumnmath) .tree, .scene.space .tree{display:none}

/* mountain decor */
.rock{display:none;position:absolute;bottom:96px;background:#7a807b;border:4px solid #5b605b}
.rock.r1{left:38px;width:76px;height:48px;clip-path:polygon(8% 100%,0 52%,22% 20%,58% 0,100% 38%,91% 100%)}
.rock.r2{left:142px;width:96px;height:58px;clip-path:polygon(9% 100%,0 55%,20% 24%,56% 0,100% 35%,93% 100%)}
.rock.r3{right:62px;width:82px;height:52px;clip-path:polygon(8% 100%,0 55%,21% 20%,60% 0,100% 34%,92% 100%)}
.scene.mountain .rock{display:block}
.scene.space .rock,.scene.space .support,.scene.space .crystal{display:none !important}
.support{display:none;position:absolute;bottom:86px;width:18px;height:126px;background:#6f4b2c;border:4px solid #3c2a1b}
.support::before{content:"";position:absolute;left:-20px;top:18px;width:58px;height:18px;background:#6f4b2c;border:4px solid #3c2a1b}
.support.s1{left:72px}.support.s2{right:94px}
.scene.mountain .support{display:block}

/* cave decor */
.crystal{display:none;position:absolute;bottom:98px;width:34px;height:58px;background:#65e7ff;border:4px solid #bdf9ff;clip-path:polygon(50% 0,100% 37%,73% 100%,27% 100%,0 37%);box-shadow:0 0 18px rgba(101,231,255,.38)}
.crystal.c1{left:38px}.crystal.c2{left:132px;transform:scale(.84)}.crystal.c3{right:62px;transform:scale(.94)}
.scene.cave .crystal{display:block}
.crystal.spark{animation:crystalPulse 2.2s ease-in-out infinite}
@keyframes crystalPulse{0%,100%{filter:brightness(1);transform:translateY(0)}50%{filter:brightness(1.35);transform:translateY(-2px)}}

/* tunnel and track */
.tunnel{
  position:absolute;right:47px;bottom:89px;width:128px;height:114px;
  background:
    linear-gradient(180deg,#8d938e 0 14px,transparent 14px),
    linear-gradient(90deg,rgba(255,255,255,.13) 1px,transparent 1px) 0 0/26px 26px,
    linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px) 0 0/26px 26px,
    #6e746f;
  border:12px solid #858b86;border-bottom:none
}
.tunnel::before{content:"";position:absolute;left:23px;bottom:0;width:56px;height:74px;background:#111411;border-radius:34px 34px 0 0}
.tunnel::after{content:"";position:absolute;left:49px;top:-23px;width:26px;height:29px;background:#f0b83f;box-shadow:0 0 0 3px rgba(0,0,0,.14) inset}
.scene.cave .tunnel{border-color:#536171;background:
  linear-gradient(180deg,#596778 0 14px,transparent 14px),
  linear-gradient(90deg,rgba(255,255,255,.1) 1px,transparent 1px) 0 0/26px 26px,
  linear-gradient(rgba(255,255,255,.06) 1px,transparent 1px) 0 0/26px 26px,
  #3d4653}
.scene.cave .tunnel::after{background:#69e9ff;box-shadow:0 0 12px rgba(105,233,255,.55)}

.rails{position:absolute;left:18px;right:18px;bottom:68px;height:60px;transform:skewX(-8deg);filter:drop-shadow(0 6px 0 rgba(0,0,0,.16))}
.sleepers{position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 24px,#6a4428 24px 37px,transparent 37px 54px)}
.metal{position:absolute;left:0;right:0;height:7px;background:#a5aaa6;border:2px solid #3e433f;box-shadow:0 1px 0 rgba(255,255,255,.2) inset}
.m1{top:12px}.m2{bottom:12px}

/* minecart + blocky rider */
.cartwrap{
  position:absolute;left:4%;bottom:88px;z-index:6;
  transition:left .78s cubic-bezier(.2,.85,.2,1),transform .35s;
  transform-origin:center bottom
}
.cartwrap.bump{animation:bump .45s}
@keyframes bump{0%{transform:translateY(0)}45%{transform:translateY(-14px) rotate(-3deg)}100%{transform:translateY(0)}}
.minecart{width:126px;height:74px;position:relative}
.minecart .body{
  position:absolute;inset:21px 7px 8px;background:
    linear-gradient(90deg,rgba(255,255,255,.12) 0 14%,transparent 14% 100%),#9ca39e;
  border:5px solid #2a2f2b;clip-path:polygon(7% 0,93% 0,84% 100%,16% 100%)
}
.minecart .rim{position:absolute;left:24px;right:24px;top:12px;height:16px;background:#c8cdca;border:3px solid #2a2f2b}
.minecart .wheel{position:absolute;bottom:0;width:22px;height:22px;background:#454b47;border:4px solid #272c28;border-radius:50%}
.minecart .w1{left:28px}.minecart .w2{right:28px}

.rider{position:absolute;left:40px;top:-28px;width:44px;height:40px;z-index:3}
.rider-head{position:absolute;left:7px;top:0;width:30px;height:28px;background:#d69a61;border:4px solid #211712}
.rider-hair{position:absolute;left:4px;top:-4px;width:36px;height:14px;background:#6a3f25;border:4px solid #211712}
.rider-eye{position:absolute;top:12px;width:4px;height:4px;background:#171514}
.re1{left:13px}.re2{left:27px}
.rider-body{position:absolute;left:10px;top:25px;width:24px;height:17px;background:#3874c8;border:4px solid #211712;border-top:none}
.rider-arm{position:absolute;top:28px;width:8px;height:14px;background:#d69a61;border:3px solid #211712}
.ra1{left:4px}.ra2{right:4px}

/* pickup particles */
.rewardburst{
  position:absolute;inset:0;display:grid;place-items:center;opacity:0;pointer-events:none;z-index:7
}
.rewardburst.show{animation:rewardPop 1.05s}
@keyframes rewardPop{
  0%{opacity:0;transform:scale(.4) rotate(-8deg)}
  35%{opacity:1;transform:scale(1.25) rotate(3deg)}
  75%{opacity:1}
  100%{opacity:0;transform:scale(1.6) translateY(-10px)}
}

/* ---------- TASK ---------- */
.task{
  display:flex;flex-direction:column;align-items:center;justify-content:center;padding:16px;
  background:linear-gradient(180deg,#353c36 0 8px,transparent 8px),linear-gradient(#2b312c,#232824);
  border:4px solid #0d100d;border-radius:13px;box-shadow:inset 0 0 0 3px #3a423b
}
.question{font-size:clamp(40px,5.5vw,72px);font-weight:1000;text-align:center;text-shadow:0 4px #000;margin:6px 0 18px}
.answer{
  width:min(100%,300px);font-size:50px;text-align:center;padding:10px;
  background:var(--cream);color:#39751f;border:6px solid #67be39;border-radius:12px;
  outline:none;box-shadow:inset 0 0 0 3px #dce6a8
}
.answer:focus{box-shadow:inset 0 0 0 3px #e7efbd,0 0 0 4px rgba(115,220,66,.18)}
.primary{
  margin-top:15px;padding:12px 24px;background:linear-gradient(#7be148,#43a724);
  border:4px solid #2a7316;border-radius:11px;box-shadow:0 6px #174c0d;
  color:#fff;font-weight:1000;font-size:clamp(22px,2.5vw,29px);cursor:pointer
}
.primary:active{transform:translateY(3px);box-shadow:0 2px #174c0d}
.tasktip{margin-top:9px;color:#cbd2cc;font-size:13px;text-align:center}
.mechanic-panel{
  margin-top:13px;width:min(420px,96%);padding:10px 12px;
  background:
    linear-gradient(90deg,rgba(255,255,255,.04) 2px,transparent 2px 28px) 0 0/30px 30px,
    linear-gradient(#2c342e,#202620);
  border:4px solid #4f5b51;outline:2px solid #0e120f;border-radius:4px;
  box-shadow:inset 0 4px 0 rgba(255,255,255,.04),0 5px 0 #0a0d0a
}
.mechanic-title{
  text-align:center;font-size:12px;font-weight:1000;letter-spacing:.5px;
  color:#f5e7a4;margin-bottom:8px;text-transform:uppercase
}
.mechanic-row{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.mechanic-card{
  min-height:72px;padding:7px 6px 6px;text-align:center;
  background:linear-gradient(#394239,#283029);border:3px solid #566158;
  box-shadow:inset 0 3px 0 rgba(255,255,255,.05),0 3px 0 #101410
}
.mechanic-card strong{display:block;margin-top:3px;font-size:11px;color:#fff}
.mechanic-card small{display:block;margin-top:2px;color:#cdd6cf;font-size:9px;line-height:1.2}
.mechanic-card.gold-card{border-color:#b68a24;background:linear-gradient(#5d4c22,#352c18)}
.mech-icon{height:30px;display:flex;align-items:center;justify-content:center}
.mech-booster{
  width:42px;height:14px;border:3px solid #6e5a18;
  background:repeating-linear-gradient(90deg,#f4ca45 0 8px,#9f7a17 8px 14px);
  box-shadow:0 0 8px rgba(244,202,69,.35)
}
.mech-loop{
  width:32px;height:32px;border:5px solid #c4ccce;border-radius:50%;
  box-shadow:inset 0 0 0 3px #78502e,0 0 0 2px #d9b53d
}

.mech-tunnel{
  position:relative;
  width:42px;height:29px;
  border:6px solid #747b77;
  border-bottom:0;
  border-radius:22px 22px 0 0;
  box-shadow:inset 0 0 0 3px #343a36;
}
.mech-tunnel::after{
  content:"";
  position:absolute;
  left:8px;right:8px;bottom:0;height:16px;
  background:#111512;
  border-radius:12px 12px 0 0;
}
.goalbar{
  margin-top:9px;padding:7px 9px;background:#171d18;border:3px solid #4a554b;
  font-size:10px;color:#d7dfd9;text-align:center
}
.goalbar b{color:#ffe16c}

/* ---------- WORLD BEAUTY PASS ---------- */
.scene{
  isolation:isolate;
}
.scene::before{
  content:"";
  position:absolute;
  inset:0;
  background:
    linear-gradient(180deg,rgba(255,255,255,.07) 0 12%,transparent 12% 100%),
    radial-gradient(circle at 50% 0,rgba(255,255,255,.08),transparent 45%);
  pointer-events:none;
  z-index:-6;
}
.ridge{
  position:absolute;
  left:-6%;
  width:112%;
  pointer-events:none;
  z-index:-3;
  filter:drop-shadow(0 6px 0 rgba(0,0,0,.16));
}
.ridge.back{
  bottom:112px;
  height:112px;
  background:#79b760;
  clip-path:polygon(0 100%,0 74%,9% 61%,17% 68%,28% 46%,39% 63%,50% 41%,59% 57%,69% 34%,78% 54%,89% 40%,100% 67%,100% 100%);
  opacity:.72;
}
.ridge.mid{
  bottom:94px;
  height:96px;
  background:#5f9c4d;
  clip-path:polygon(0 100%,0 72%,13% 52%,23% 62%,34% 39%,46% 58%,55% 46%,66% 29%,75% 51%,88% 37%,100% 59%,100% 100%);
}
.scene.mountain .ridge.back{background:#b2b39f;opacity:.78}
.scene.mountain .ridge.mid{background:#8a8d82}
.scene.cave .ridge,
.scene.space .ridge{display:none}
.scene.autumnmath .ridge.back{background:#dfaa58}
.scene.autumnmath .ridge.mid{background:#bb743d}
.scene.snowmath .ridge.back{background:#d9eef8}
.scene.snowmath .ridge.mid{background:#b7d5e0}
.scene.rainbowmath .ridge.back{background:#8ece7d}
.scene.rainbowmath .ridge.mid{background:#6cb15f}
.scene.goldcity .ridge.back{background:#d8bb68}
.scene.goldcity .ridge.mid{background:#b98944}

.voxel-cloud{
  position:absolute;
  width:92px;height:26px;
  background:#fff;
  box-shadow:20px 0 #fff,40px 0 #fff,24px -16px #fff,56px -8px #fff;
  image-rendering:pixelated;
  opacity:.93;
  z-index:-2;
}
.vc1{left:9%;top:14%}
.vc2{right:13%;top:18%;transform:scale(1.12)}
.vc3{left:41%;top:9%;transform:scale(.78)}
.scene.cave .voxel-cloud,
.scene.space .voxel-cloud{display:none}

.grass-patch{
  position:absolute;
  bottom:95px;
  width:28px;height:26px;
  z-index:1;
  pointer-events:none;
}
.grass-patch::before,.grass-patch::after,.grass-patch i{
  content:"";
  position:absolute;
  bottom:0;
  width:9px;height:24px;
  background:#54b84d;
  border:2px solid #2d7231;
  clip-path:polygon(50% 0,100% 100%,0 100%);
}
.grass-patch::before{left:1px}
.grass-patch i{left:10px;height:20px}
.grass-patch::after{right:1px;height:18px}
.gp1{left:14%}.gp2{left:25%}.gp3{right:22%}.gp4{right:12%}
.scene.mountain .grass-patch::before,.scene.mountain .grass-patch::after,.scene.mountain .grass-patch i{background:#87a765;border-color:#587148}
.scene.autumnmath .grass-patch::before,.scene.autumnmath .grass-patch::after,.scene.autumnmath .grass-patch i{background:#ce7a32;border-color:#8f4f23}
.scene.snowmath .grass-patch::before,.scene.snowmath .grass-patch::after,.scene.snowmath .grass-patch i{background:#effcff;border-color:#abc7d4}
.scene.goldcity .grass-patch::before,.scene.goldcity .grass-patch::after,.scene.goldcity .grass-patch i{background:#d8aa4a;border-color:#8c6320}
.scene.cave .grass-patch,
.scene.space .grass-patch{display:none}

.flower-clump{
  position:absolute;
  bottom:98px;
  width:42px;height:22px;
  z-index:1;
  pointer-events:none;
}
.flower-clump::before,.flower-clump::after{
  content:"";
  position:absolute;
  bottom:0;
  width:9px;height:9px;
  background:#f08db4;
  border:2px solid #b35a83;
  box-shadow:0 -7px 0 #ffd466;
}
.flower-clump::before{left:8px}
.flower-clump::after{right:8px}
.fc1{left:31%}.fc2{right:31%}
.scene.autumnmath .flower-clump::before,.scene.autumnmath .flower-clump::after{background:#edc14e;border-color:#b97b1f;box-shadow:0 -7px 0 #f6e8af}
.scene.snowmath .flower-clump{display:none}
.scene.cave .flower-clump,
.scene.space .flower-clump{display:none}

.block-post{
  position:absolute;
  bottom:92px;
  width:18px;height:52px;
  background:#6f4b2c;
  border:4px solid #3a2719;
  z-index:1;
  pointer-events:none;
}
.block-post::before{
  content:"";
  position:absolute;
  left:-10px;top:-10px;
  width:30px;height:16px;
  background:#8a6138;
  border:4px solid #3a2719;
}
.block-post::after{
  content:"";
  position:absolute;
  left:-6px;top:-34px;
  width:22px;height:22px;
  background:#f3c34c;
  border:4px solid #7a5715;
  box-shadow:0 0 12px rgba(243,195,76,.35);
}
.bp1{left:7%}.bp2{right:21%}
.scene.space .block-post::after{background:#9be7ff;border-color:#317b92;box-shadow:0 0 12px rgba(155,231,255,.4)}
.scene.cave .block-post::after{background:#6de8ff;border-color:#317b92;box-shadow:0 0 12px rgba(109,232,255,.4)}
.scene.cave .block-post,
.scene.space .block-post{display:block}
.scene:not(.cave):not(.space) .block-post.bp2{display:none}

.block-house{
  position:absolute;
  right:10%;
  bottom:96px;
  width:76px;height:58px;
  z-index:0;
  pointer-events:none;
  display:none;
}
.block-house .roof{
  position:absolute;left:8px;top:0;width:60px;height:18px;
  background:#875433;border:4px solid #4c2d1b;
}
.block-house .wall{
  position:absolute;left:0;right:0;bottom:0;height:42px;
  background:#caa266;border:4px solid #7f5d38;
  box-shadow:inset 0 0 0 3px rgba(255,255,255,.08);
}
.block-house .door{
  position:absolute;left:29px;bottom:0;width:18px;height:24px;
  background:#754a2c;border:4px solid #412817;
}
.block-house .win{
  position:absolute;top:18px;width:13px;height:13px;
  background:#a4e7ff;border:3px solid #497387;
}
.block-house .w1{left:10px}.block-house .w2{right:10px}
.scene.forest .block-house,
.scene.river .block-house,
.scene.rainbowmath .block-house{display:block}
.scene.autumnmath .block-house .wall{background:#d1a16b}
.scene.river .block-house .wall{background:#cfcfb9}

.waterfall{
  position:absolute;
  left:11%;
  bottom:96px;
  width:34px;height:92px;
  background:linear-gradient(180deg,#a7f1ff,#4ec2ef);
  border:4px solid #3a8fb0;
  box-shadow:0 0 10px rgba(78,194,239,.24);
  display:none;
  z-index:0;
  pointer-events:none;
}
.waterfall::before{
  content:"";
  position:absolute;
  left:-14px;right:-14px;bottom:-7px;height:12px;
  background:#72d0f3;
  border:3px solid #3a8fb0;
}
.scene.river .waterfall{display:block}

.gold-spire{
  position:absolute;
  right:11%;
  bottom:96px;
  width:34px;height:112px;
  background:#e0b24b;
  border:4px solid #8a6321;
  display:none;
  z-index:0;
  pointer-events:none;
  box-shadow:0 0 14px rgba(224,178,75,.18);
}
.gold-spire::before{
  content:"";
  position:absolute;
  left:-8px;top:-18px;
  width:42px;height:22px;
  background:#f2ce64;
  border:4px solid #8a6321;
  clip-path:polygon(50% 0,100% 100%,0 100%);
}
.gold-spire::after{
  content:"";
  position:absolute;
  left:9px;top:22px;width:8px;height:8px;
  background:#fff2a1;box-shadow:0 24px 0 #fff2a1,0 48px 0 #fff2a1;
}
.scene.goldcity .gold-spire{display:block}

.rail-spark{
  position:absolute;
  bottom:121px;width:6px;height:6px;
  background:#ffe98a;opacity:.8;
  box-shadow:10px 7px 0 #fff4bd,-9px 5px 0 #ffe98a;
  animation:twinkle 2.6s ease-in-out infinite;
  pointer-events:none;
  z-index:2;
}
.rs1{left:21%}.rs2{right:29%;animation-delay:.8s}
@keyframes twinkle{0%,100%{opacity:.2;transform:translateY(0) scale(.7)}50%{opacity:1;transform:translateY(-3px) scale(1)}}
.scene.cave .rail-spark,
.scene.space .rail-spark{display:none}

.scene.space .front-rail-sign{
  background:#33465d;border-color:#172533;color:#dff7ff;
}
.scene.space .voxel-cloud,
.scene.space .block-house,
.scene.space .waterfall,
.scene.space .gold-spire{display:none}
.scene.space .block-post.bp1{left:9%;bottom:92px}
.scene.space .coaster-hint{opacity:.66}
.front-rail-sign{
  position:absolute;left:15px;bottom:88px;z-index:2;
  padding:6px 10px;background:#6f4d2e;border:3px solid #3d291a;
  color:#f6e6b2;font-size:10px;font-weight:1000;letter-spacing:.3px;
  box-shadow:0 3px 0 rgba(0,0,0,.35),inset 0 2px 0 rgba(255,255,255,.08);transform:rotate(-2deg)
}
.scene .coaster-hint{
  position:absolute;right:7%;bottom:82px;width:132px;height:84px;
  z-index:1;opacity:.48;pointer-events:none
}
.scene .coaster-hint .hint-loop{
  position:absolute;right:2px;bottom:0;width:66px;height:66px;
  border:6px solid rgba(206,216,219,.82);border-radius:50%;
  box-shadow:inset 0 0 0 4px rgba(117,78,43,.85)
}
.scene .coaster-hint .hint-track{
  position:absolute;left:0;right:54px;bottom:9px;height:7px;
  background:#b6c0c1;box-shadow:0 11px 0 #b6c0c1
}
.scene .coaster-hint .hint-track::after{
  content:"";position:absolute;left:0;right:0;top:-4px;height:24px;
  background:repeating-linear-gradient(90deg,transparent 0 12px,#74502f 12px 17px,transparent 17px 23px)
}
body.theme-space .scene .coaster-hint{opacity:.64;filter:drop-shadow(0 0 6px rgba(128,231,255,.25))}
body.theme-goldcity .scene .coaster-hint{opacity:.7;filter:drop-shadow(0 0 8px rgba(255,214,91,.28))}
@media(max-width:700px){
  .mechanic-panel{width:100%;box-sizing:border-box}
  .mechanic-card{min-height:66px;padding:6px 4px}
  .scene .coaster-hint{right:3%;transform:scale(.82);transform-origin:right bottom}
  .front-rail-sign{font-size:9px;left:8px}
}

/* stronger block-world UI */
.task{
  border-radius:4px!important;border:5px solid #4f5b50!important;outline:3px solid #111611;
  background:linear-gradient(90deg,rgba(255,255,255,.035) 2px,transparent 2px 30px) 0 0/32px 32px,linear-gradient(#303831,#202720)!important;
  box-shadow:inset 0 5px 0 rgba(255,255,255,.04),inset 0 -6px 0 rgba(0,0,0,.22)
}
.question{
  padding:12px 18px;background:#171d18;border:4px solid #59655a;border-radius:3px!important;
  box-shadow:inset 0 0 0 3px #0d110e,0 5px 0 #0a0d0a;text-shadow:3px 3px 0 #000
}
.answer{border-radius:3px!important;border-width:5px!important;box-shadow:inset 0 4px 0 rgba(0,0,0,.18),0 4px 0 #0b0e0b}
.primary{
  border-radius:3px!important;
  background:linear-gradient(180deg,rgba(255,255,255,.16) 0 18%,transparent 18%),linear-gradient(#79dc4c,#3e9b28)!important;
  border:5px solid #225f16!important;outline:2px solid #112e0b;box-shadow:0 6px 0 #153f0f!important;
  text-transform:uppercase;letter-spacing:.4px
}
.primary:active{transform:translateY(4px);box-shadow:0 2px 0 #153f0f!important}
.level-chip,.progress,.soundbtn,.sidebtn,.trophybtn,.starbox,.inventory,.slot,.feedback{border-radius:3px!important}
.sidebtn,.trophybtn,.soundbtn{
  background:linear-gradient(180deg,rgba(255,255,255,.10) 0 18%,transparent 18%),linear-gradient(#465048,#2a312b)!important;
  border-width:4px!important
}
.feedback{border-width:4px!important;box-shadow:inset 0 3px 0 rgba(255,255,255,.03)}


/* ---------- FEEDBACK/HUD ---------- */
.feedback{
  margin:0 12px 12px;min-height:60px;padding:10px 14px;
  display:flex;align-items:center;justify-content:center;text-align:center;
  background:#1b201b;border:3px solid #0c0f0c;border-radius:10px;
  font-size:clamp(18px,2.2vw,25px);font-weight:900
}
.hud{display:flex;align-items:center;gap:9px;flex-wrap:wrap;padding:0 12px 12px}
.starbox,.inventory,.trophybtn{
  background:#151915;border:3px solid #4b554d;border-radius:9px
}
.starbox{display:flex;align-items:center;gap:7px;padding:8px 12px;color:#ffe16a;font-weight:1000}
.inventory{display:flex;gap:6px;padding:6px;flex:1;justify-content:center}
.slot{
  position:relative;width:52px;height:52px;display:grid;place-items:center;
  background:linear-gradient(#3c443d,#2d332e);border:3px solid #707a71;border-radius:6px;
  box-shadow:inset 0 0 0 2px #1b211c
}
.slot::after{content:"";position:absolute;inset:3px;border-top:2px solid rgba(255,255,255,.08);pointer-events:none}
.slot small{position:absolute;right:3px;bottom:1px;font-size:11px;font-weight:1000}
.trophybtn{width:54px;height:54px;display:grid;place-items:center}

/* ---------- BUILDER ---------- */
.builder{display:none;padding:12px}
.builder.open{display:block}
.builder-head{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.builder-head h2{margin:0;font-size:clamp(24px,3vw,34px)}
.builder-info{color:#e6eee8;font-size:14px}
.build-area{
  position:relative;min-height:338px;border:5px solid #0d100d;border-radius:4px;overflow:hidden;
  background:linear-gradient(180deg,var(--sky2) 0 42%,var(--ground) 42% 66%,var(--earth) 66%)
}
.build-area::before{
  content:"";position:absolute;inset:0;pointer-events:none;opacity:.95;
}
.build-area::after{
  content:"";position:absolute;inset:0;pointer-events:none;opacity:.13;
  background:
    linear-gradient(90deg,rgba(255,255,255,.14) 1px,transparent 1px) 0 0/26px 26px,
    linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px) 0 0/26px 26px
}

.build-world{
  position:absolute;
  inset:0 auto 0 0;
  width:360%;
  min-width:2260px;
  transform:translateX(0);
  will-change:transform;
}

.builder-quick-actions{
  display:flex;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
  margin:10px 0 12px;
  position:sticky;
  top:8px;
  z-index:12;
}
.ride-btn-top{
  box-shadow:0 6px 0 #224f15,0 10px 18px rgba(0,0,0,.22);
}


.build-camera-controls{
  display:flex;
  gap:10px;
  justify-content:center;
  align-items:center;
  flex-wrap:wrap;
  margin:10px 0 2px;
}
.camera-btn{
  min-width:132px;
  padding:9px 14px;
  border:3px solid #59635b;
  border-radius:10px;
  background:linear-gradient(#3c443e,#2b312d);
  color:#fff;
  font-weight:900;
  box-shadow:0 4px 0 #111512;
  cursor:pointer;
}
.camera-btn:disabled{opacity:.42;cursor:default}
.camera-page{
  min-width:92px;
  text-align:center;
  color:#dce6de;
  font-size:13px;
  font-weight:900;
}

/* Background decoration layer */
.deco-grid{
  position:absolute;
  left:3%;
  right:3%;
  top:20px;
  height:104px;
  display:grid;
  grid-template-columns:repeat(24,1fr);
  gap:7px;
  z-index:2;
  pointer-events:none;
}
.deco-slot{
  position:relative;
  height:104px;
  border:2px dashed rgba(255,255,255,.12);
  border-radius:9px;
  pointer-events:auto;
  cursor:pointer;
}
.deco-slot:hover{background:rgba(255,255,255,.045)}
.deco-slot.deco-target{border-color:rgba(255,221,92,.56);background:rgba(255,221,92,.06)}
.deco-slot.deco-remove-target{border-color:rgba(241,110,102,.58);background:rgba(241,110,102,.07)}

.deco-controls{
  margin-top:12px;
  padding:10px;
  border:3px solid #28302a;
  border-radius:12px;
  background:rgba(15,20,16,.28);
}
.deco-title{
  text-align:center;
  font-weight:1000;
  margin-bottom:8px;
  color:#f0f5f1;
}
.deco-buttons{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  justify-content:center;
}
.deco-btn{
  min-width:92px;
  padding:8px 9px;
  border:3px solid #59635b;
  border-radius:10px;
  background:linear-gradient(#3a423c,#292f2b);
  color:#fff;
  font-weight:900;
  box-shadow:0 4px 0 #111512;
  cursor:pointer;
  font-size:12px;
}
.deco-btn.selected{outline:3px solid #f1c84f;background:#485148}
.deco-btn:disabled{opacity:.45;cursor:default}
.deco-btn small{display:block;margin-top:2px;color:#d0dad2;font-size:10px}
.deco-remove-btn.active{outline:3px solid #df746d;background:#553633}

/* Block-world decoration art */
.deco{
  position:absolute;
  left:50%;
  transform:translateX(-50%);
  pointer-events:none;
}
.deco.tree{bottom:-13px;width:50px;height:78px}
.deco.tree .trunk{position:absolute;left:20px;bottom:0;width:13px;height:38px;background:#6e4427;border:2px solid #3f2819}
.deco.tree .leaf1,.deco.tree .leaf2,.deco.tree .leaf3{position:absolute;background:#4d9f46;border:2px solid #2f6b32}
.deco.tree .leaf1{left:7px;bottom:29px;width:38px;height:28px}
.deco.tree .leaf2{left:14px;bottom:51px;width:28px;height:22px}
.deco.tree .leaf3{left:0;bottom:39px;width:18px;height:19px}

.deco.sun{top:4px;width:48px;height:48px;background:#ffd95b;border:4px solid #a97920;box-shadow:0 0 18px rgba(255,217,91,.42)}
.deco.sun::before,.deco.sun::after{content:"";position:absolute;background:#ffd95b}
.deco.sun::before{left:-13px;right:-13px;top:18px;height:8px}
.deco.sun::after{top:-13px;bottom:-13px;left:18px;width:8px}

.deco.torch{bottom:-11px;width:28px;height:66px}
.deco.torch .stick{position:absolute;left:11px;bottom:0;width:8px;height:43px;background:#81512d;border:2px solid #4b2e1c}
.deco.torch .flame{position:absolute;left:5px;top:0;width:18px;height:24px;background:#ffbd3c;border:3px solid #d76e24;box-shadow:0 0 12px rgba(255,150,48,.55)}
.deco.torch .flame::after{content:"";position:absolute;left:4px;top:5px;width:7px;height:10px;background:#fff08b}

.deco.flower{bottom:-10px;width:34px;height:52px}
.deco.flower .stem{position:absolute;left:15px;bottom:0;width:5px;height:31px;background:#438a43}
.deco.flower .head{position:absolute;left:7px;top:2px;width:21px;height:21px;background:#f08ca9;border:3px solid #b74f74}
.deco.flower .head::after{content:"";position:absolute;left:5px;top:5px;width:6px;height:6px;background:#ffd45e}

.deco.crystal{display:block !important;bottom:-7px;width:36px;height:58px}
.deco.crystal .c1,.deco.crystal .c2,.deco.crystal .c3{position:absolute;bottom:0;background:#78ebff;border:3px solid #3a9fb5;transform:skew(-8deg)}
.deco.crystal .c1{left:10px;width:15px;height:54px}
.deco.crystal .c2{left:0;width:12px;height:35px}
.deco.crystal .c3{right:0;width:11px;height:29px}
.deco.crystal{filter:drop-shadow(0 0 8px rgba(113,235,255,.38))}

.deco.mushroom{bottom:-10px;width:45px;height:48px}
.deco.mushroom .stem{position:absolute;left:16px;bottom:0;width:15px;height:26px;background:#eee1c4;border:2px solid #9f8e72}
.deco.mushroom .cap{position:absolute;left:5px;top:0;width:36px;height:22px;background:#cb4e45;border:3px solid #7e302c}
.deco.mushroom .cap::after{content:"";position:absolute;left:7px;top:5px;width:7px;height:7px;background:#f6dfca;box-shadow:14px 2px 0 #f6dfca}

.deco.star{top:8px;width:46px;height:46px;color:#ffe568;font-size:45px;line-height:46px;text-align:center;text-shadow:0 0 10px rgba(255,229,104,.55)}

.deco.chest{bottom:-10px;width:54px;height:42px}
.deco.chest .lid{position:absolute;left:2px;top:0;width:50px;height:17px;background:#9b6334;border:3px solid #56341f}
.deco.chest .box{position:absolute;left:0;bottom:0;width:54px;height:28px;background:#7c4b2a;border:3px solid #4b2b1b}
.deco.chest .lock{position:absolute;left:23px;top:18px;width:10px;height:13px;background:#e6c14f;border:2px solid #8f7329;z-index:2}


.deco.bird{top:12px;width:46px;height:28px;animation:birdFloat 2.8s ease-in-out infinite}
.deco.bird .body{position:absolute;left:10px;top:10px;width:18px;height:12px;background:#78b8ff;border:2px solid #356ea7;border-radius:8px}
.deco.bird .wing{position:absolute;left:15px;top:12px;width:10px;height:8px;background:#5a95dd;border:2px solid #356ea7;transform-origin:left center;animation:birdWing 1s ease-in-out infinite}
.deco.bird .head{position:absolute;left:25px;top:7px;width:11px;height:11px;background:#8fc7ff;border:2px solid #356ea7;border-radius:50%}
.deco.bird .eye{position:absolute;left:31px;top:11px;width:2px;height:2px;background:#17222e}
.deco.bird .beak{position:absolute;left:37px;top:11px;width:7px;height:6px;background:#f0b343;clip-path:polygon(0 50%,100% 0,100% 100%)}
.deco.bird .tail{position:absolute;left:5px;top:13px;width:8px;height:8px;background:#5a95dd;border:2px solid #356ea7;clip-path:polygon(100% 0,0 50%,100% 100%)}
@keyframes birdFloat{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-4px)}}
@keyframes birdWing{0%,100%{transform:rotate(0deg)}50%{transform:rotate(-18deg)}}

.deco.bee{top:24px;width:48px;height:30px;animation:beeBuzz 1.8s linear infinite}
.deco.bee .body{position:absolute;left:13px;top:10px;width:22px;height:14px;background:linear-gradient(90deg,#f6c742 0 30%,#513d16 30% 42%,#f6c742 42% 64%,#513d16 64% 76%,#f6c742 76% 100%);border:2px solid #7a5b18;border-radius:10px}
.deco.bee .wing1,.deco.bee .wing2{position:absolute;top:4px;width:12px;height:10px;background:rgba(211,244,255,.9);border:2px solid #89bfd2;border-radius:10px 10px 0 10px;animation:beeWing .22s linear infinite}
.deco.bee .wing1{left:14px;transform:rotate(-15deg)}
.deco.bee .wing2{left:24px;transform:rotate(12deg);animation-delay:.11s}
.deco.bee .eye{position:absolute;left:31px;top:14px;width:2px;height:2px;background:#17130a}
.deco.bee .stinger{position:absolute;left:35px;top:14px;width:8px;height:6px;background:#513d16;clip-path:polygon(0 50%,100% 0,100% 100%)}
@keyframes beeBuzz{0%,100%{transform:translateX(-50%) translate(0,0)}25%{transform:translateX(-50%) translate(2px,-2px)}50%{transform:translateX(-50%) translate(0,-4px)}75%{transform:translateX(-50%) translate(-2px,-2px)}}
@keyframes beeWing{0%,100%{transform:scaleY(1) rotate(-10deg)}50%{transform:scaleY(.45) rotate(-2deg)}}

.deco.frog{bottom:-8px;width:50px;height:34px;animation:frogBlink 3.2s steps(1) infinite}
.deco.frog .body{position:absolute;left:9px;bottom:8px;width:30px;height:16px;background:#6cc66f;border:2px solid #2f7d3b;border-radius:10px}
.deco.frog .head{position:absolute;left:13px;bottom:18px;width:22px;height:10px;background:#79d47d;border:2px solid #2f7d3b;border-bottom:none;border-radius:10px 10px 0 0}
.deco.frog .eye1,.deco.frog .eye2{position:absolute;bottom:26px;width:7px;height:7px;background:#79d47d;border:2px solid #2f7d3b;border-radius:50%}
.deco.frog .eye1{left:14px}.deco.frog .eye2{left:27px}
.deco.frog .eye1::after,.deco.frog .eye2::after{content:"";position:absolute;left:2px;top:2px;width:2px;height:2px;background:#121d12;border-radius:50%}
.deco.frog .leg1,.deco.frog .leg2{position:absolute;bottom:2px;width:12px;height:10px;background:#59b55e;border:2px solid #2f7d3b;border-top:none}
.deco.frog .leg1{left:8px;transform:skewX(18deg)}
.deco.frog .leg2{right:8px;transform:skewX(-18deg)}
@keyframes frogBlink{0%,93%,100%{transform:translateX(-50%) translateY(0)}94%,96%{transform:translateX(-50%) translateY(1px)}}

.deco.butterfly{top:10px;width:50px;height:34px;animation:butterflyFloat 2.4s ease-in-out infinite}
.deco.butterfly .body{position:absolute;left:23px;top:9px;width:5px;height:18px;background:#3c3027;border:2px solid #241d18}
.deco.butterfly .wing1,.deco.butterfly .wing2,.deco.butterfly .wing3,.deco.butterfly .wing4{position:absolute;background:#ff89d2;border:2px solid #a84d87;transform-origin:center right;animation:butterflyFlap .7s ease-in-out infinite}
.deco.butterfly .wing1{left:7px;top:6px;width:16px;height:13px;border-radius:14px 14px 2px 14px}
.deco.butterfly .wing2{left:8px;top:19px;width:14px;height:11px;border-radius:10px 10px 10px 14px;animation-delay:.08s}
.deco.butterfly .wing3{left:27px;top:6px;width:16px;height:13px;border-radius:14px 14px 14px 2px;transform-origin:center left}
.deco.butterfly .wing4{left:28px;top:19px;width:14px;height:11px;border-radius:10px 10px 14px 10px;transform-origin:center left;animation-delay:.08s}
.deco.butterfly .dot1,.deco.butterfly .dot2,.deco.butterfly .dot3,.deco.butterfly .dot4{position:absolute;width:4px;height:4px;background:#fff1a8;border-radius:50%}
.deco.butterfly .dot1{left:14px;top:11px}.deco.butterfly .dot2{left:32px;top:11px}.deco.butterfly .dot3{left:14px;top:22px}.deco.butterfly .dot4{left:32px;top:22px}
@keyframes butterflyFloat{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(-5px)}}
@keyframes butterflyFlap{0%,100%{transform:scaleY(1)}50%{transform:scaleY(.72)}}

.deco.bush{bottom:-10px;width:56px;height:34px}
.deco.bush .b1,.deco.bush .b2,.deco.bush .b3{position:absolute;bottom:0;background:#4ea655;border:2px solid #2c6b35}
.deco.bush .b1{left:6px;width:18px;height:18px}
.deco.bush .b2{left:18px;width:20px;height:24px}
.deco.bush .b3{left:32px;width:18px;height:18px}
.deco.cloud{top:12px;width:58px;height:30px;animation:cloudDrift 5.5s ease-in-out infinite}
.deco.cloud .c1,.deco.cloud .c2,.deco.cloud .c3{position:absolute;background:#eef7ff;border:2px solid #b9d3e5}
.deco.cloud .c1{left:5px;top:11px;width:18px;height:12px}
.deco.cloud .c2{left:17px;top:6px;width:22px;height:15px}
.deco.cloud .c3{left:33px;top:11px;width:18px;height:12px}
@keyframes cloudDrift{0%,100%{transform:translateX(-50%) translateX(0)}50%{transform:translateX(-50%) translateX(5px)}}
.deco.pumpkin{bottom:-10px;width:44px;height:34px}
.deco.pumpkin .body{position:absolute;left:7px;bottom:0;width:28px;height:24px;background:#f0932b;border:2px solid #914d16;border-radius:9px}
.deco.pumpkin .body::before,.deco.pumpkin .body::after{content:"";position:absolute;top:-1px;bottom:-1px;width:6px;border-left:2px solid rgba(145,77,22,.7);border-right:2px solid rgba(145,77,22,.7)}
.deco.pumpkin .body::before{left:6px}.deco.pumpkin .body::after{right:6px}
.deco.pumpkin .stem{position:absolute;left:18px;bottom:23px;width:7px;height:8px;background:#4f7d29;border:2px solid #35571a}
.deco.rainbow{top:4px;width:64px;height:38px}
.deco.rainbow::before{content:"";position:absolute;left:4px;right:4px;bottom:2px;height:30px;border-radius:40px 40px 0 0;background:linear-gradient(180deg,#ff6c6c 0 16%,#ffb95b 16% 32%,#ffe96d 32% 48%,#7ee17b 48% 64%,#79c7ff 64% 80%,#b88cff 80% 100%);clip-path:inset(0 0 52% 0)}
.deco.rainbow::after{content:"";position:absolute;left:9px;right:9px;bottom:7px;height:20px;border-radius:30px 30px 0 0;background:rgba(255,255,255,.18);clip-path:inset(0 0 50% 0)}

