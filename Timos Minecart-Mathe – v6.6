    return `<div class="item"><div style="font-size:28px">${d.symbol}</div><strong>${state.decorations[d.id]||0}</strong><span>${d.label}${unlocked?"":" · ab "+d.unlock+" ⭐"}</span></div>`
  }).join("");
  $("modalContent").innerHTML=`<h2>${svgIcon("i-trophy","icon-lg")} Sammlung</h2><h3>Materialien</h3><div class="collection">${materialHtml}</div><h3 style="margin-top:16px">Hintergrunddeko</h3><div class="collection">${decoHtml}</div>`;
  $("modal").classList.add("open")
}

