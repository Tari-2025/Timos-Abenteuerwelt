  renderBuild()
}
function closeBuilder(){
  $("builder").classList.remove("open");
  document.querySelector(".main-grid").style.display="";
  $("feedback").style.display=""
}
function getBuiltCount(){let c=0;for(const p of state.build){if(!p)break;c++}return c}
let manualCameraX=0;

function cameraLimits(){
  const area=$("buildArea"),world=$("buildWorld");
  if(!area||!world)return{max:0};
  return{max:Math.max(0,world.offsetWidth-area.clientWidth)};
}
function applyManualCamera(){
  const world=$("buildWorld");
  if(!world)return;
  const max=cameraLimits().max;
  manualCameraX=Math.max(0,Math.min(max,manualCameraX));
  world.style.transform=`translateX(${-manualCameraX}px)`;
  const left=$("cameraLeftBtn"),right=$("cameraRightBtn"),page=$("cameraPage");
  if(left)left.disabled=manualCameraX<=1;
  if(right)right.disabled=manualCameraX>=max-1;
  if(page){
    const sections=max>0?Math.max(2,Math.ceil((max+1)/($("buildArea").clientWidth*.62))):1;
    const current=max>0?Math.min(sections,Math.floor(manualCameraX/Math.max(1,max)*(sections-1))+1):1;
    page.textContent=`Abschnitt ${current} / ${sections}`;
  }
}
function moveBuildCamera(dir){
  const area=$("buildArea");
  if(!area)return;
  manualCameraX+=dir*area.clientWidth*.62;
  applyManualCamera();
}
function resetBuildCamera(){
  manualCameraX=0;
  applyManualCamera();
}

function followBuilderCart(cartX){
  const area=$("buildArea");
  const world=$("buildWorld");
  if(!area || !world) return;

  const viewport=area.clientWidth;
  const worldWidth=world.scrollWidth || world.getBoundingClientRect().width;
  const desired=viewport*.46-cartX;
  const minTranslate=Math.min(0, viewport-worldWidth);
  const translate=Math.max(minTranslate, Math.min(0, desired));
  world.style.transform=`translateX(${translate}px)`;
  manualCameraX=Math.max(0,-translate);
}

function positionBuilderTunnel(){
  const tunnel=$("builderTunnel");
  const area=document.querySelector(".build-area");
  const segments=rideSegments();
  if(!tunnel || !area || !segments.length){
    if(tunnel) tunnel.style.bottom="64px";
    return;
  }
  const end=segments[segments.length-1].b;
  const trackBottom=area.clientHeight-end.y-28;
  const tunnelBottom=Math.max(42, trackBottom-12);
  tunnel.style.bottom=tunnelBottom+"px";
}

function rideSegments(){
  const count=getBuiltCount();
  const area=document.querySelector(".build-area").getBoundingClientRect();
  const slots=[...document.querySelectorAll(".build-slot")];
  if(count===0)return[];

  const segments=[];

  for(let i=0;i<count;i++){
    const r=slots[i].getBoundingClientRect();
    const piece=state.build[i];

    const x0=r.left-area.left+2;
    const x1=r.right-area.left-2;
    const width=x1-x0;
    const baseY=r.bottom-area.top-35;

    if(piece==="tunnel-start" && i+2<count){
      const r1=slots[i].getBoundingClientRect();
      const r2=slots[i+1].getBoundingClientRect();
      const r3=slots[i+2].getBoundingClientRect();
      const tx0=r1.left-area.left+2;
      const tx1=r1.right-area.left-2;
      const tx2=r2.right-area.left-2;
      const tx3=r3.right-area.left-2;

      segments.push({
        piece:"tunnel-enter",
        a:{x:tx0,y:baseY},
        b:{x:tx1,y:baseY},
        duration:430
      });
      segments.push({
        piece:"tunnel-dark",
        a:{x:tx1,y:baseY},
        b:{x:tx2,y:baseY},
        duration:520
      });
      segments.push({
        piece:"tunnel-exit",
        a:{x:tx2,y:baseY},
        b:{x:tx3,y:baseY},
        duration:430
      });

      i+=2;
      continue
    }

    if(piece==="loop-start" && i+4<count){
      const lastRect=slots[i+4].getBoundingClientRect();
      const middleLeft=slots[i+1].getBoundingClientRect().left-area.left;
      const middleRight=slots[i+3].getBoundingClientRect().right-area.left;
      const endX=lastRect.right-area.left-2;

      const cx=(middleLeft+middleRight)/2;
      const rx=Math.max(54,(middleRight-middleLeft)*.38);
      const ry=Math.min(92,rx*.82);
      const cy=baseY-ry;

      // Approach from the first of the five occupied slots to the bottom of the loop.
      segments.push({
        piece:"loop-approach",
        a:{x:x0,y:baseY},
        b:{x:cx,y:baseY},
        angleStart:0,
        angleEnd:0,
        duration:330
      });

      // Full 360° loop. The cart orientation follows the track continuously.
      const steps=24;
      for(let k=0;k<steps;k++){
        const t0=k/steps;
        const t1=(k+1)/steps;
        const th0=Math.PI/2-t0*Math.PI*2;
        const th1=Math.PI/2-t1*Math.PI*2;
        const a={x:cx+rx*Math.cos(th0),y:cy+ry*Math.sin(th0)};
        const b={x:cx+rx*Math.cos(th1),y:cy+ry*Math.sin(th1)};
        segments.push({
          piece:"loop",
          a,b,
          angleStart:-360*t0,
          angleEnd:-360*t1,
          duration:55
        });
      }

      // Exit over the fifth occupied slot.
      segments.push({
        piece:"loop-exit",
        a:{x:cx,y:baseY},
        b:{x:endX,y:baseY},
        angleStart:-360,
        angleEnd:-360,
        duration:330
      });

      i+=4;
      continue
    }

    if(piece==="jump-start" && i+2<count){
      const lastRect=slots[i+2].getBoundingClientRect();
      const endX=lastRect.right-area.left-2;
      const peak=72;
      const steps=8;
      for(let k=0;k<steps;k++){
        const t0=k/steps;
        const t1=(k+1)/steps;
        const point=t=>({x:x0+(endX-x0)*t,y:baseY-Math.sin(Math.PI*t)*peak});
        const p0=point(t0),p1=point(t1);
        segments.push({piece:"jump",a:p0,b:p1,duration:115});
      }
      i+=2;
      continue
    }

    if(piece==="corkscrew-start" && i+3<count){
      const lastRect=slots[i+3].getBoundingClientRect();
      const endX=lastRect.right-area.left-2;
      const steps=18;
      for(let k=0;k<steps;k++){
        const t0=k/steps;
        const t1=(k+1)/steps;
        const point=t=>({
          x:x0+(endX-x0)*t,
          y:baseY-Math.sin(t*Math.PI*2)*16
        });
        const p0=point(t0),p1=point(t1);
        segments.push({
          piece:"corkscrew",
          a:p0,b:p1,
          angleStart:0,angleEnd:0,
          rollStart:720*t0,
          rollEnd:720*t1,
          duration:70
        });
      }
      i+=3;
      continue
    }

    // Reserved multi-slot pieces are consumed by their start element above.
    if(String(piece).startsWith("loop-") || String(piece).startsWith("tunnel-") ||
       String(piece).startsWith("jump-") || String(piece).startsWith("corkscrew-"))continue;

    if(piece==="jump-legacy"){
      const peak=44;
      const steps=4;
      for(let k=0;k<steps;k++){
        const t0=k/steps;
        const t1=(k+1)/steps;
        const point=t=>({x:x0+(x1-x0)*t,y:baseY-Math.sin(Math.PI*t)*peak});
        const p0=point(t0),p1=point(t1);
        segments.push({piece:"jump",a:p0,b:p1,duration:120});
      }
    }else if(piece==="up"){
      segments.push({
        piece,
        a:{x:x0,y:baseY},
        b:{x:x1,y:baseY-STEP_HEIGHT}
      });
    }else if(piece==="down"){
      segments.push({
        piece,
        a:{x:x0,y:baseY},
        b:{x:x1,y:baseY+STEP_HEIGHT}
      });
    }else if(piece==="bridge"){
      const bridgeRise=24;
      const xa=x0+width*.22;
      const xb=x0+width*.78;

      segments.push({
        piece:"bridge-up",
        a:{x:x0,y:baseY},
        b:{x:xa,y:baseY-bridgeRise}
      });
      segments.push({
        piece:"bridge-top",
        a:{x:xa,y:baseY-bridgeRise},
        b:{x:xb,y:baseY-bridgeRise}
      });
      segments.push({
        piece:"bridge-down",
        a:{x:xb,y:baseY-bridgeRise},
        b:{x:x1,y:baseY}
      });
    }else{
      segments.push({
        piece,
        a:{x:x0,y:baseY},
        b:{x:x1,y:baseY}
      });
    }
  }

  return segments;
}

async function ride(){
  if(getBuiltCount()===0){
    buildStatus("Baue zuerst mindestens ein Streckenteil.",true);
    return;
  }

  // Start every ride from the beginning of the long build world.
  resetBuildCamera();
  const buildWrap=$("buildArea");
  if(buildWrap && buildWrap.scrollIntoView){
    buildWrap.scrollIntoView({block:"center",behavior:"smooth"});
    await new Promise(resolve=>setTimeout(resolve,260));
  }
  await new Promise(resolve=>requestAnimationFrame(()=>requestAnimationFrame(resolve)));

  buildStatus("Los geht's – deine Lore folgt deiner Strecke bis in den Tunnel!");
  Sound.ride();
  ride.loopSoundPlayed=false;
  ride.jumpSoundPlayed=false;
  ride.corkscrewSoundPlayed=false;

  const cart=$("builderCart");
  const area=document.querySelector(".build-area");
  const tunnel=$("builderTunnel");
  const loading=$("builderLoading");
  const loaderBar=$("loaderBar");
  const segments=rideSegments();
  if(!segments.length)return;

  positionBuilderTunnel();

  for(const seg of segments){
    const a=seg.a;
    const b=seg.b;
    const dx=b.x-a.x;
    const dy=b.y-a.y;
    const naturalAngle=Math.atan2(dy,dx)*180/Math.PI;
    const angleStart=Number.isFinite(seg.angleStart)?seg.angleStart:naturalAngle;
    const angleEnd=Number.isFinite(seg.angleEnd)?seg.angleEnd:naturalAngle;

    const startLeft=a.x;
    const startBottom=area.clientHeight-a.y-28;
    const endLeft=b.x;
    const endBottom=area.clientHeight-b.y-28;

    let duration=Number.isFinite(seg.duration)?seg.duration:650;
    let easing="linear";

    if(seg.piece==="boost"){
      duration=330;
      easing="cubic-bezier(.2,.9,.2,1)";
    }else if(seg.piece==="jump"){
      duration=150;
      easing="cubic-bezier(.22,.75,.18,1)";
    }else if(seg.piece==="up" || seg.piece==="down"){
      duration=720;
    }else if(seg.piece==="bridge-up" || seg.piece==="bridge-down"){
      duration=280;
      easing="ease-in-out";
    }else if(seg.piece==="bridge-top"){
      duration=380;
    }

    if(seg.piece==="loop" && !ride.loopSoundPlayed){
      ride.loopSoundPlayed=true;
      Sound.loopRide();
      buildStatus("Booster-Schub! Die Lore geht in den Looping! 🎢");
    }
    if(seg.piece==="jump" && !ride.jumpSoundPlayed){
      ride.jumpSoundPlayed=true;
      Sound.jumpRide();
      buildStatus("Sprung! Die Lore fliegt wirklich über die freie Lücke! ⭐");
    }
    if(seg.piece==="corkscrew" && !ride.corkscrewSoundPlayed){
      ride.corkscrewSoundPlayed=true;
      Sound.corkscrewRide();
      buildStatus("Korkenzieher! Die Lore dreht sich seitlich durch die Strecke! 🌀");
    }

    let startOpacity=1,endOpacity=1;
    let startFilter="brightness(1)",endFilter="brightness(1)";
    if(seg.piece==="tunnel-enter"){
      Sound.tunnelRide();
      buildStatus("Ab in den Felsentunnel! ⛏️");
      endOpacity=.52;
      endFilter="brightness(.24)";
    }else if(seg.piece==="tunnel-dark"){
      startOpacity=.52;endOpacity=.52;
      startFilter="brightness(.24)";endFilter="brightness(.20)";
    }else if(seg.piece==="tunnel-exit"){
      startOpacity=.52;
      startFilter="brightness(.22)";
      endOpacity=1;
      endFilter="brightness(1)";
    }

    const rollStart=Number.isFinite(seg.rollStart)?seg.rollStart:0;
    const rollEnd=Number.isFinite(seg.rollEnd)?seg.rollEnd:0;
    const startTransform=seg.piece==="corkscrew"
      ? `perspective(360px) rotate(${angleStart}deg) rotateY(${rollStart}deg)`
      : `rotate(${angleStart}deg)`;
    const endTransform=seg.piece==="corkscrew"
      ? `perspective(360px) rotate(${angleEnd}deg) rotateY(${rollEnd}deg)`
      : `rotate(${angleEnd}deg)`;

    const anim=cart.animate([
      {
        left:startLeft+"px",
        bottom:startBottom+"px",
        transform:startTransform,
        opacity:startOpacity,
        filter:startFilter
      },
      {
        left:endLeft+"px",
        bottom:endBottom+"px",
        transform:endTransform,
        opacity:endOpacity,
        filter:endFilter
      }
    ],{
      duration,
      easing,
      fill:"forwards"
    });

    const camStart=performance.now();
    const camStep=(now)=>{
      const t=Math.min(1,(now-camStart)/duration);
      followBuilderCart(startLeft+(endLeft-startLeft)*t);
      if(t<1) requestAnimationFrame(camStep);
    };
    requestAnimationFrame(camStep);

    await anim.finished;
  }

  // Das letzte Stück: sichtbar bis in die Tunnelöffnung hinein.
  const tunnelRect=tunnel.getBoundingClientRect();
  const areaRect=area.getBoundingClientRect();
  const last=segments[segments.length-1].b;

  const tunnelCenterX=tunnelRect.left-areaRect.left+tunnelRect.width*.52;
  const tunnelMouthY=tunnelRect.bottom-areaRect.top-38;

  const fromLeft=last.x;
  const fromBottom=area.clientHeight-last.y-28;
  const toLeft=tunnelCenterX-38;
  const toBottom=area.clientHeight-tunnelMouthY-28;

  followBuilderCart(fromLeft);
  const enterCamStart=performance.now();
  const enterCamDuration=900;
  const enterCamStep=(now)=>{
    const t=Math.min(1,(now-enterCamStart)/enterCamDuration);
    followBuilderCart(fromLeft+(toLeft+22-fromLeft)*t);
    if(t<1) requestAnimationFrame(enterCamStep);
  };
  requestAnimationFrame(enterCamStep);

  const enterAnim=cart.animate([
    {
      left:fromLeft+"px",
      bottom:fromBottom+"px",
      transform:"rotate(0deg) scale(1)",
      opacity:1,
      filter:"brightness(1)"
    },
    {
      offset:.62,
      left:(toLeft-8)+"px",
      bottom:(toBottom+2)+"px",
      transform:"rotate(0deg) scale(.88)",
      opacity:1,
      filter:"brightness(.72)"
    },
    {
      left:(toLeft+22)+"px",
      bottom:(toBottom+4)+"px",
      transform:"rotate(0deg) scale(.52)",
      opacity:0,
      filter:"brightness(.25)"
    }
  ],{
    duration:900,
    easing:"cubic-bezier(.25,.7,.2,1)",
    fill:"forwards"
  });

  await enterAnim.finished;

  buildStatus("Die Lore ist im Tunnel …");

  // Kurzer Ladebildschirm als Übergang.
  loading.classList.remove("open");
  void loading.offsetWidth;
  loaderBar.style.width="";
  loading.classList.add("open");

  await new Promise(resolve=>setTimeout(resolve,1750));

  loading.classList.remove("open");
  cart.getAnimations().forEach(a=>a.cancel());
  cart.style.left="5%";
  cart.style.bottom="92px";
  cart.style.transform="rotate(0deg)";
  cart.style.opacity="1";
  cart.style.filter="none";

  resetBuildCamera();
  buildStatus("Tunnel geschafft! Die Lore steht wieder am Start.");
}

